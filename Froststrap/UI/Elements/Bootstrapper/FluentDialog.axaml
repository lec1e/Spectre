<base:AvaloniaDialogBase
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Froststrap.UI.ViewModels.Bootstrapper"
    xmlns:base="clr-namespace:Froststrap.UI.Elements.Bootstrapper.Base"
    xmlns:gv="using:Froststrap.UI.ViewModels"
    xmlns:controls="clr-namespace:Froststrap.UI.Elements.Controls"
    xmlns:app="clr-namespace:Froststrap"
    mc:Ignorable="d"
    x:Class="Froststrap.UI.Elements.Bootstrapper.FluentDialog"
    x:DataType="vm:FluentDialogViewModel"
    Width="420"
    Height="360"
    MinWidth="420"
    MaxWidth="420"
    MinHeight="360"
    MaxHeight="360"
    CanResize="False"
    Title="{x:Static app:App.BrandName}"
    WindowStartupLocation="CenterScreen"
    ExtendClientAreaToDecorationsHint="True"
    TransparencyLevelHint="{Binding WindowBackdropType}"
    Background="{DynamicResource WbWindowBackgroundBrush}">

    <Panel>
        <controls:AnimatedBackground x:Name="Backdrop" />

        <Grid RowDefinitions="36,*,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="14,0,0,0">
                <Panel WindowDecorationProperties.ElementRole="TitleBar" Background="Transparent" />
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock FontSize="11" Text="{Binding VersionText}" Foreground="{DynamicResource WbFgFaintBrush}"
                               IsVisible="{x:Static gv:GlobalViewModel.IsWindowsOrMacOS}"/>
                    <TextBlock FontSize="11" Text="{Binding ChannelText}" Foreground="{DynamicResource WbFgFaintBrush}"
                               IsVisible="{x:Static gv:GlobalViewModel.IsWindowsOrMacOS}"/>
                </StackPanel>
                <controls:IconButton Grid.Column="1" Classes="TitleBarButton Close"
                                     Icon="X" Command="{Binding CancelInstallCommand}" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="28,4,28,0" Spacing="14" VerticalAlignment="Center">
                <controls:SpectreLogo Width="64" Height="64" Glow="0.65" HorizontalAlignment="Center" />

                <StackPanel Spacing="3">
                    <TextBlock Text="{x:Static app:App.BrandName}" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="{DynamicResource WbLogoBrush}" />
                    <TextBlock Text="{Binding ProductVersion}" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{DynamicResource WbFgMutedBrush}" />
                </StackPanel>

                <TextBlock HorizontalAlignment="Center" TextAlignment="Center"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource WbFgBrightBrush}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Message}"/>

                <ProgressBar Height="6" CornerRadius="50"
                             Foreground="{DynamicResource WbAccentBrush}"
                             Background="{DynamicResource WbFillBrush}"
                             IsIndeterminate="{Binding ProgressIndeterminate}"
                             Maximum="{Binding ProgressMaximum}"
                             Value="{Binding ProgressValue}"/>
            </StackPanel>

            <controls:IconButton Grid.Row="2" Classes="ghost"
                                 Margin="28,0,28,22"
                                 HorizontalAlignment="Stretch"
                                 Height="40"
                                 CornerRadius="12"
                                 Icon="X"
                                 IconSize="14"
                                 Content="{Binding CancelButtonText}"
                                 Padding="16,0"
                                 IsEnabled="{Binding CancelEnabled}"
                                 Command="{Binding CancelInstallCommand}" />
        </Grid>
    </Panel>
</base:AvaloniaDialogBase>
