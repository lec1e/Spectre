<base:AvaloniaWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:base="clr-namespace:Froststrap.UI.Elements.Base"
        xmlns:controls="clr-namespace:Froststrap.UI.Elements.Controls"
        xmlns:vm="clr-namespace:Froststrap.UI.ViewModels.Dialogs"
        x:Class="Froststrap.UI.Elements.Dialogs.VipServerPickerDialog"
        x:DataType="vm:VipServerPickerViewModel"
        Title="Pick a VIP server"
        Width="560" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        CanResize="False">
    <Panel>
        <controls:LiquidGlassPanel x:Name="ShellGlass"
                                   Margin="0"
                                   Padding="0"
                                   CornerRadius="0"
                                   TintOpacity="0.58"
                                   MaterialOpacity="0.46"
                                   UseSettingsCornerRadius="False"
                                   ClipToBounds="True">
            <Panel>
                <controls:AbyssGlowBackground x:Name="AbyssBackground" />
                <Grid Margin="22,16,22,18" RowDefinitions="Auto,*,Auto">
                <TextBlock Text="{Binding GameName}"
                           FontWeight="SemiBold"
                           FontSize="16" />

                <Grid Grid.Row="1" Margin="0,12,0,12">
                    <ListBox ItemsSource="{Binding Servers}"
                             SelectedItem="{Binding SelectedServer}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,3"
                                        Padding="12,10"
                                        CornerRadius="12"
                                        Background="#22FFFFFF"
                                        BorderBrush="#44FFFFFF"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Loading VIP servers..."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsLoading}" />

                    <TextBlock Text="No VIP servers found."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding ShowEmptyState}" />
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    <controls:IconButton Content="Skip" MinWidth="100" Height="38" CornerRadius="14"
                                         Classes="Primary" Icon="X" IconSize="16" Padding="16,0"
                                         Click="Skip_Click" />
                    <controls:IconButton Content="Join" MinWidth="100" Height="38" CornerRadius="14"
                                         Classes="Primary" Icon="Play" IconSize="16" Padding="16,0"
                                         Click="Join_Click" />
                </StackPanel>
            </Grid>
            </Panel>
        </controls:LiquidGlassPanel>
    </Panel>
</base:AvaloniaWindow>
