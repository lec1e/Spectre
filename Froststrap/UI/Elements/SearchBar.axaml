<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
             xmlns:models="using:Froststrap.Models"
             xmlns:controls="using:Froststrap.UI.Elements.Controls"
             xmlns:resources="using:Froststrap.Resources"
             xmlns:vm="clr-namespace:Froststrap.UI.ViewModels"
             xmlns:robloxApis="using:Froststrap.Models.APIs.Roblox"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="Froststrap.UI.Elements.SearchBar"
             x:DataType="vm:SearchBarViewModel">

    <UserControl.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement, TextBox:focus /template/ Border#PART_BorderElement, TextBox:focus-within /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="{DynamicResource WbFgFaintBrush}" />
            <Setter Property="Margin" Value="0" />
        </Style>
    </UserControl.Styles>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
        <Border x:Name="SearchHost" Classes="sidebar-search">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
        <TextBox x:Name="SearchTextBox" Grid.Column="0"
                 PlaceholderText="Search Spectre…"
                 Text="{Binding SearchQuery}"
                 VerticalAlignment="Center"
                 VerticalContentAlignment="Center"
                 HorizontalContentAlignment="Left"
                 Padding="4,0,4,0"
                 MinHeight="22"
                 FontSize="12"
                 Foreground="{DynamicResource WbFgBrush}"
                 CaretBrush="{DynamicResource WbFgBrightBrush}"
                 Background="Transparent"
                 BorderBrush="Transparent"
                 BorderThickness="0">

            <TextBox.InnerLeftContent>
                <controls:IconButton Command="{Binding ToggleSearchListCommand}"
                                     Classes="TitleBarButton"
                                     Icon="Search"
                                     IconSize="14"
                                     Width="22"
                                     Height="22"
                                     Padding="0"
                                     Margin="0,0,6,0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource WbFgFaintBrush}"
                                     IsTabStop="False"
                                     VerticalAlignment="Center">
                </controls:IconButton>
            </TextBox.InnerLeftContent>

            <TextBox.InnerRightContent>
                <Button Command="{Binding ClearSearchCommand}"
                        Classes="chrome"
                        IsVisible="{Binding SearchQuery, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Background="Transparent"
                        BorderThickness="0"
                        Width="28"
                        Height="28"
                        Padding="0"
                        Margin="0,0,2,0"
                        VerticalAlignment="Center">
                    <ic:Lucide Icon="X"
                               Height="14"
                               Width="14"/>
                </Button>
            </TextBox.InnerRightContent>
        </TextBox>

                <Border Grid.Column="1" Classes="kbd" VerticalAlignment="Center">
                    <TextBlock Text="Ctrl K" FontSize="10" Foreground="{DynamicResource WbFgFaintBrush}" />
                </Border>
            </Grid>
        </Border>

        <Popup PlacementTarget="{Binding #SearchHost}"
               Placement="BottomEdgeAlignedLeft"
               HorizontalOffset="0"
               VerticalOffset="4"
               IsLightDismissEnabled="True"
               Opened="OnResultsOpened"
               IsOpen="{Binding IsSearchFlyoutOpen, Mode=TwoWay}">
                    <Border x:Name="ResultsPanel"
                            MaxHeight="168"
                            Background="{DynamicResource WbOverlayBrush}"
                            BorderBrush="{DynamicResource WbLineStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            BoxShadow="0 6 16 0 #40000000"
                            Margin="0">
                        <Grid RowDefinitions="*,Auto">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          IsVisible="{Binding HasAnyResults}"
                                          ScrollChanged="OnScrollChanged">
                                <StackPanel Spacing="0" Margin="4">
                                    <ItemsControl ItemsSource="{Binding FilteredSearchResults}" HorizontalAlignment="Stretch">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:SearchBarItem">
                                                <Button Classes="chrome"
                                                        Command="{Binding $parent[UserControl].DataContext.SearchResultSelectedCommand}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Stretch"
                                                        Background="Transparent"
                                                        BorderBrush="{DynamicResource WbLineBrush}"
                                                        HorizontalContentAlignment="Left"
                                                        Padding="6,2"
                                                        CornerRadius="4"
                                                        Margin="0">
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <ic:Lucide Grid.Column="0"
                                                                   Icon="{Binding IconSymbol, FallbackValue=Settings}"
                                                                   Height="14"
                                                                   Width="14"
                                                                   Opacity="0.8"
                                                                   Margin="0,0,8,0"
                                                                   VerticalAlignment="Center" />

                                                        <StackPanel Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    Spacing="0">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding PageName}"
                                                                       FontSize="10"
                                                                       Opacity="0.6"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding GameSearchResults}" HorizontalAlignment="Stretch">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="robloxApis:OmniSearchContent">
                                                <Border Background="Transparent"
                                                        BorderBrush="{DynamicResource WbLineBrush}"
                                                        HorizontalAlignment="Stretch"
                                                        BorderThickness="1"
                                                        Padding="6"
                                                        Margin="0,2"
                                                        CornerRadius="6">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" HorizontalAlignment="Stretch">
                                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="4" ClipToBounds="True"
                                                                Background="{DynamicResource ControlAlphaEmbedFillColorDefaultBrush}">
                                                            <Image RenderOptions.BitmapInterpolationMode="HighQuality"
                                                                   Source="{Binding ThumbnailBitmap}"
                                                                   Stretch="UniformToFill" />
                                                        </Border>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                                                <ic:Lucide Icon="Users" Height="12" Width="12" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding PlayerCount, Converter={StaticResource NumberAbbreviationConverter}}"
                                                                           FontSize="11" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <controls:IconButton Grid.Column="2"
                                                                             Command="{Binding $parent[UserControl].DataContext.RegionJoinGameCommand}"
                                                                             CommandParameter="{Binding}"
                                                                             Padding="0"
                                                                             ToolTip.Tip="Region Selector"
                                                                             Margin="0,0,4,0" Width="32" Height="32"
                                                                             IconSize="16"
                                                                             Icon="Globe"
                                                                             Background="{DynamicResource WbRaisedBrush}"
                                                                             CornerRadius="6"/>

                                                        <controls:IconButton Grid.Column="3"
                                                                             Command="{Binding $parent[UserControl].DataContext.PlayGameCommand}"
                                                                             CommandParameter="{Binding}"
                                                                             ToolTip.Tip="Quick Play"
                                                                             Classes="Primary"
                                                                             Width="32" Height="32"
                                                                             Padding="0"
                                                                             IconSize="16"
                                                                             Icon="Play"
                                                                             CornerRadius="6"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <TextBlock Text="{x:Static resources:Strings.Common_NoResult}"
                                       IsVisible="{Binding !HasAnyResults}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Padding="20"
                                       Opacity="0.5" />

                            <ProgressBar Grid.Row="1"
                                         IsIndeterminate="True"
                                         Height="2"
                                         VerticalAlignment="Bottom"
                                         IsVisible="{Binding IsGameSearchLoading}" />
                        </Grid>
                    </Border>
        </Popup>
    </Grid>
</UserControl>