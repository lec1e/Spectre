<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Froststrap.UI.Elements.Controls"
             xmlns:studio="using:Froststrap.Integrations"
             xmlns:vm="clr-namespace:Froststrap.UI.ViewModels.Settings"
             x:Class="Froststrap.UI.Elements.Settings.Pages.ChatsStudioPage"
             x:DataType="vm:ChatsStudioViewModel"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
  <controls:FitHost>
    <Grid RowDefinitions="Auto,*">
    <controls:AccountStrip />
    <Grid Grid.Row="1" ColumnDefinitions="280,*" ColumnSpacing="12">
      <Border Background="{DynamicResource WbFillBrush}" BorderBrush="{DynamicResource WbLineStrongBrush}" BorderThickness="1" CornerRadius="16" Padding="12" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
            <Button Content="Refresh" MinWidth="96" Command="{Binding RefreshCommand}" />
            <Button Content="{Binding PickerLabel}" MinWidth="96" Command="{Binding ToggleFriendsCommand}" />
          </StackPanel>
          <controls:WheelScroll Grid.Row="1" Margin="0,10,0,0">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding Conversations}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="studio:ChatConversation">
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,4" Padding="10,8"
                            Command="{Binding $parent[UserControl].((vm:ChatsStudioViewModel)DataContext).OpenCommand}"
                            CommandParameter="{Binding Id}">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Preview}" Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </controls:WheelScroll>
          <TextBlock Grid.Row="2" Text="{Binding Status}" Opacity="0.65" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="#121216" BorderBrush="{DynamicResource WbLineStrongBrush}" BorderThickness="1" CornerRadius="16" Padding="14" ClipToBounds="True">
        <Panel>
        <Grid IsVisible="{Binding PickingFriend}" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
          <StackPanel Spacing="4">
            <TextBlock Text="New chat" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Pick one friend for a direct chat, or two to five for a party." Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock Text="Selected" FontSize="12" FontWeight="SemiBold" Opacity="0.8" />
            <TextBlock Text="{Binding PartyCount}" Opacity="0.55" FontSize="12" IsVisible="{Binding NobodyChosen}" />
            <ItemsControl ItemsSource="{Binding Chosen}" IsVisible="{Binding HasChosen}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatFriend">
                  <Border Margin="0,0,6,6" Padding="8,4" CornerRadius="8" Background="{DynamicResource WbFillBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                      <Button Content="Remove" Padding="8,2" MinHeight="0"
                              Command="{Binding $parent[UserControl].((vm:ChatsStudioViewModel)DataContext).ToggleFriendCommand}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBox Text="{Binding PartyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Party name (optional)" MaxLength="150" IsVisible="{Binding NamingParty}" />
            <TextBlock Text="Friends" FontSize="12" FontWeight="SemiBold" Opacity="0.8" />
            <TextBox Text="{Binding FriendQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Search friends" />
          </StackPanel>
          <Grid Grid.Row="2" ClipToBounds="True">
            <TextBlock Text="Loading friends…" Opacity="0.55" IsVisible="{Binding FriendsLoading}" />
            <TextBlock Text="This account has no friends to message." Opacity="0.55" TextWrapping="Wrap" IsVisible="{Binding NoFriends}" />
            <TextBlock Text="No friends match that search." Opacity="0.55" IsVisible="{Binding NoFriendMatches}" />
            <controls:WheelScroll IsVisible="{Binding HasShownFriends}">
              <ItemsControl ItemsSource="{Binding ShownFriends}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChatFriend">
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,8,4" Padding="10,8"
                            Command="{Binding $parent[UserControl].((vm:ChatsStudioViewModel)DataContext).ToggleFriendCommand}"
                            CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="22,*">
                        <TextBlock Text="{Binding Mark}" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <StackPanel Grid.Column="1" Spacing="1">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Opacity="0.55" FontSize="11" Text="{Binding Username, StringFormat='@{0}'}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </controls:WheelScroll>
          </Grid>
          <Button Grid.Row="3" Content="{Binding CreateLabel}" Classes="accent" HorizontalAlignment="Right" MinWidth="140"
                  Command="{Binding CreatePartyCommand}" IsEnabled="{Binding CanCreate}" />
        </Grid>
        <Grid IsVisible="{Binding ShowThread}" RowDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding ThreadTitle}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{Binding MessageCount, StringFormat='{}{0} messages'}" Opacity="0.45" FontSize="12" VerticalAlignment="Center"
                       IsVisible="{Binding HasConversation}" />
          </StackPanel>
          <Grid Grid.Row="1" Margin="0,12,0,0" ClipToBounds="True">
            <controls:WheelScroll x:Name="ThreadScroll">
              <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="studio:ChatLine">
                    <Border Margin="0,0,8,8" Padding="10,8" CornerRadius="12" MaxWidth="460"
                            Background="{DynamicResource WbFillBrush}"
                            HorizontalAlignment="{Binding Alignment}">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CreatedAt}" Opacity="0.45" FontSize="11" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </controls:WheelScroll>
            <TextBlock Text="{Binding ThreadHint}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.45"
                       IsVisible="{Binding ShowThreadHint}" IsHitTestVisible="False" />
          </Grid>
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,12,0,0" Background="#121216">
            <TextBox x:Name="DraftBox" Text="{Binding Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Write a message" MinHeight="36"
                     IsEnabled="{Binding HasConversation}" />
            <Button Grid.Column="1" Content="Send" Classes="accent" Command="{Binding SendCommand}" MinWidth="76" VerticalAlignment="Center" />
          </Grid>
        </Grid>
        </Panel>
      </Border>
    </Grid>
    </Grid>
  </controls:FitHost>
</UserControl>
