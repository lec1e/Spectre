<base:AvaloniaWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:base="clr-namespace:Froststrap.UI.Elements.Base"
        xmlns:controls="clr-namespace:Froststrap.UI.Elements.Controls"
        xmlns:vm="clr-namespace:Froststrap.UI.ViewModels.Dialogs"
        x:Class="Froststrap.UI.Elements.Dialogs.VersionPickerDialog"
        x:DataType="vm:VersionPickerViewModel"
        Title="Pick a version profile"
        Width="420" Height="420"
        MinWidth="420" MinHeight="360"
        MaxWidth="420" MaxHeight="480"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="Transparent">
    <Panel>
        <controls:LiquidGlassPanel x:Name="ShellGlass"
                                   Margin="0"
                                   CornerRadius="0"
                                   TintOpacity="0.58"
                                   MaterialOpacity="0.46"
                                   UseSettingsCornerRadius="False"
                                   ClipToBounds="True">
            <Panel>
                <controls:AbyssGlowBackground x:Name="AbyssBackground" />
                <Grid Margin="22,16,22,18" RowDefinitions="Auto,*,Auto">
                    <TextBlock Text="Which profile should launch?" FontWeight="SemiBold" FontSize="16" Foreground="White" />
                    <ListBox Grid.Row="1" Margin="0,12,0,12" ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding SelectedProfile}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="{Binding VersionGuid}" FontFamily="Consolas" FontSize="11" Opacity="0.7"
                                               IsVisible="{Binding VersionGuid, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <TextBlock Text="Latest LIVE" FontSize="11" Opacity="0.7"
                                               IsVisible="{Binding VersionGuid, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <controls:IconButton Content="Cancel" MinWidth="100" Height="38" CornerRadius="14"
                                             Classes="Primary" Icon="X" IconSize="16" Padding="16,0"
                                             Click="Cancel_Click" />
                        <controls:IconButton Content="Launch" MinWidth="100" Height="38" CornerRadius="14"
                                             Classes="Primary" Icon="Play" IconSize="16" Padding="16,0"
                                             Click="Launch_Click" />
                    </StackPanel>
                </Grid>
            </Panel>
        </controls:LiquidGlassPanel>
    </Panel>
</base:AvaloniaWindow>
