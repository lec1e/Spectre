<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
             xmlns:vm="clr-namespace:Froststrap.UI.ViewModels.Settings"
             x:Class="Froststrap.UI.Elements.Settings.Pages.HomeDashboardPage"
             x:DataType="vm:HomeDashboardViewModel"
             Background="Transparent">

  <UserControl.Styles>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontFamily" Value="{StaticResource SpectreFont}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.section-link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Height" Value="28" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.section-link /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.section-link /template/ Border#PART_Fill">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.section-link:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.section-link:pointerover /template/ Border#PART_Fill">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.section-link TextBlock">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,24,32,32" Spacing="28">

      <StackPanel Spacing="4">
        <TextBlock Text="{Binding Greeting}" FontSize="13" FontWeight="Medium"
                   FontFamily="{StaticResource SpectreFont}"
                   Foreground="White" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding DisplayName}" FontSize="36" FontWeight="Bold"
                   FontFamily="{StaticResource SpectreFont}"
                   LetterSpacing="1.4"
                   Foreground="White"
                   HorizontalAlignment="Left"
                   Margin="0,0,0,4" />

        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,12,0,0" HorizontalAlignment="Left">
          <Button Classes="eclipse-primary" Width="168" Height="40" Padding="0" CornerRadius="12"
                  BorderThickness="0" Command="{Binding LaunchRobloxCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
              <ic:Lucide Icon="Play" Width="15" Height="15" StrokeBrush="White" />
              <TextBlock Text="Launch Roblox" FontWeight="SemiBold" Foreground="White"
                         FontFamily="{StaticResource SpectreFont}" />
            </StackPanel>
          </Button>
          <Button Classes="eclipse-ghost" Width="140" Height="40" Padding="0" CornerRadius="12"
                  Command="{Binding OpenFolderCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
              <ic:Lucide Icon="Folder" Width="15" Height="15" StrokeBrush="White" />
              <TextBlock Text="Open Folder" Foreground="White"
                         FontFamily="{StaticResource SpectreFont}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>

      <StackPanel Spacing="12">
        <Grid Height="28" ColumnDefinitions="*,Auto">
          <TextBlock Classes="section-title" Text="Recently Played" />
          <Button Grid.Column="1" Classes="section-link" Command="{Binding OpenQuickPlayCommand}">
            <TextBlock Text="View all" />
          </Button>
        </Grid>

        <Border IsVisible="{Binding HasNoRecentGames}" Height="88" CornerRadius="14"
                Background="#661A060A" BorderBrush="Transparent" BorderThickness="0" Padding="16">
          <StackPanel VerticalAlignment="Center" Spacing="3">
            <TextBlock Text="No recent games yet" FontSize="13.5" FontWeight="SemiBold" Foreground="White" />
            <TextBlock Text="Play with tracking on to build your history."
                       FontSize="12" Foreground="White" />
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding RecentGames}" IsVisible="{Binding HasRecentGames}"
                      Margin="0,0,-12,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="4" Rows="1" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HomeGameCard">
              <Border Height="140" Margin="0,0,12,0" CornerRadius="14" ClipToBounds="True"
                      BorderBrush="Transparent" BorderThickness="0">
                <Panel>
                  <Border Background="{Binding TintBrush}" />
                  <Image Stretch="UniformToFill" IsVisible="{Binding HasImage}"
                         Source="{Binding ImageUrl, Converter={StaticResource UrlToBitmapConverter}}" />
                  <Border>
                    <Border.Background>
                      <LinearGradientBrush StartPoint="50%,30%" EndPoint="50%,100%">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#F0140508" Offset="1" />
                      </LinearGradientBrush>
                    </Border.Background>
                  </Border>
                  <Grid Margin="12" ColumnDefinitions="*,Auto" VerticalAlignment="Bottom">
                    <StackPanel Spacing="2" Margin="0,0,8,0">
                      <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                 Foreground="White" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="White"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="eclipse-primary" Width="30" Height="30" Padding="0" CornerRadius="15"
                            BorderThickness="0" VerticalAlignment="Bottom"
                            Command="{Binding $parent[UserControl].((vm:HomeDashboardViewModel)DataContext).PlayPlaceCommand}"
                            CommandParameter="{Binding PlaceId}">
                      <ic:Lucide Icon="Play" Width="12" Height="12" StrokeBrush="White"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                  </Grid>
                </Panel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="24" MinHeight="220">
        <Grid.RowDefinitions>
          <RowDefinition Height="28" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="*,Auto">
          <TextBlock Classes="section-title" Text="Featured" />
          <Button Grid.Column="1" Classes="section-link" Command="{Binding OpenQuickPlayCommand}">
            <TextBlock Text="Explore" />
          </Button>
        </Grid>
        <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto">
          <TextBlock Classes="section-title" Text="News" />
          <Button Grid.Column="1" Classes="section-link" Command="{Binding OpenNewsCommand}">
            <TextBlock Text="All" />
          </Button>
        </Grid>

        <ItemsControl Grid.Row="1" Grid.Column="0" Margin="0,12,0,0" ItemsSource="{Binding FeaturedGames}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HomeFeaturedItem">
              <Border Margin="0,0,0,10" Padding="12,10" CornerRadius="12" Height="68"
                      Background="#881A060A" BorderBrush="Transparent" BorderThickness="0">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <Border Width="72" Height="44" CornerRadius="9" ClipToBounds="True" Background="#22000000">
                    <Panel>
                      <Border Background="{Binding TintBrush}" />
                      <Image Stretch="UniformToFill" IsVisible="{Binding HasImage}"
                             Source="{Binding ImageUrl, Converter={StaticResource UrlToBitmapConverter}}" />
                    </Panel>
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                               FontFamily="{StaticResource SpectreFont}"
                               Foreground="White"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Description}" FontSize="11"
                               FontFamily="{StaticResource SpectreFont}"
                               Foreground="White"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Button Grid.Column="2" Classes="eclipse-primary" Height="30" MinWidth="64" Padding="10,0"
                          CornerRadius="9" VerticalAlignment="Center"
                          BorderBrush="Transparent" BorderThickness="0"
                          Foreground="White" Content="Play" FontWeight="SemiBold" FontSize="12"
                          Command="{Binding $parent[UserControl].((vm:HomeDashboardViewModel)DataContext).PlayPlaceCommand}"
                          CommandParameter="{Binding PlaceId}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" ItemsSource="{Binding NewsItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HomeNewsItem">
              <Border Margin="0,0,0,10" Padding="12,10" CornerRadius="12" Height="68"
                      Background="#881A060A" BorderBrush="Transparent" BorderThickness="0">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <Border Width="32" Height="32" CornerRadius="9" VerticalAlignment="Center" ClipToBounds="True">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#E11D48" Offset="0" />
                        <GradientStop Color="#000000" Offset="1" />
                      </LinearGradientBrush>
                    </Border.Background>
                    <Image Source="avares://Eclipse/SpectreMark.png" Width="22" Height="22"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5"
                               FontFamily="{StaticResource SpectreFont}"
                               Foreground="White"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="11"
                               FontFamily="{StaticResource SpectreFont}"
                               Foreground="White"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding When}" FontSize="10.5"
                             FontFamily="{StaticResource SpectreFont}"
                             Foreground="White"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Right" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
