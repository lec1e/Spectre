<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
             xmlns:vm="clr-namespace:Froststrap.UI.ViewModels.Settings"
             x:Class="Froststrap.UI.Elements.Settings.Pages.ToolsHubPage"
             x:DataType="vm:ToolsHubViewModel"
             Background="Transparent">
  <UserControl.Styles>
    <Style Selector="Button.spectre-tile">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#E8E11D48" Offset="0" />
          <GradientStop Color="#C44A1518" Offset="0.5" />
          <GradientStop Color="#F2000000" Offset="1" />
        </LinearGradientBrush>
      </Setter>
    </Style>
    <Style Selector="Button.spectre-tile /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.spectre-tile:pointerover /template/ Border#PART_Fill">
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#F43F5E" Offset="0" />
          <GradientStop Color="#E11D48" Offset="0.35" />
          <GradientStop Color="#000000" Offset="1" />
        </LinearGradientBrush>
      </Setter>
    </Style>
  </UserControl.Styles>
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16">
      <TextBlock Text="All tools" FontSize="28" FontWeight="Bold" Foreground="White" />
      <TextBlock Text="Everything else lives here — pick a tool to open it."
                 Foreground="White" Opacity="0.8" Margin="0,0,0,8" />
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ToolsHubItem">
            <Button Classes="spectre-tile" Width="260" Height="88" Margin="0,0,12,12"
                    Padding="14" CornerRadius="14"
                    HorizontalContentAlignment="Left"
                    Command="{Binding $parent[UserControl].((vm:ToolsHubViewModel)DataContext).OpenToolCommand}"
                    CommandParameter="{Binding Tag}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border Width="40" Height="40" CornerRadius="12" ClipToBounds="True">
                  <Panel>
                    <Border CornerRadius="12">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                          <GradientStop Color="#E8E11D48" Offset="0" />
                          <GradientStop Color="#F2000000" Offset="1" />
                        </LinearGradientBrush>
                      </Border.Background>
                    </Border>
                    <Border Height="14" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0.55">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                          <GradientStop Color="#88FFFFFF" Offset="0" />
                          <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                      </Border.Background>
                    </Border>
                    <Border BorderThickness="1" CornerRadius="12" IsHitTestVisible="False">
                      <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                          <GradientStop Color="#AAFFFFFF" Offset="0" />
                          <GradientStop Color="#55E11D48" Offset="0.5" />
                          <GradientStop Color="#22000000" Offset="1" />
                        </LinearGradientBrush>
                      </Border.BorderBrush>
                    </Border>
                    <ic:Lucide Icon="{Binding Icon}" Width="18" Height="18"
                               StrokeBrush="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Panel>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="White" />
                  <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="White" Opacity="0.75" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
