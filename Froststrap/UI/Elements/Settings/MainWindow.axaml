<base:AvaloniaWindow
    x:Class="Froststrap.UI.Elements.Settings.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Froststrap.UI.Elements.Base"
    xmlns:controls="clr-namespace:Froststrap.UI.Elements.Controls"
    xmlns:elements="clr-namespace:Froststrap.UI.Elements"
    xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
    xmlns:local="clr-namespace:Froststrap.UI.Elements.Settings"
    xmlns:enums="using:Froststrap.Enums"
    xmlns:resources="using:Froststrap.Resources"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:vm="clr-namespace:Froststrap.UI.ViewModels.Settings"
    Title="{x:Static resources:Strings.Menu_Title}"
    Icon="avares://Eclipse/Eclipse.ico"
    Width="1280"
    Height="800"
    MinWidth="1080"
    MinHeight="680"
    x:DataType="vm:MainWindowViewModel"
    CanResize="True"
    WindowStartupLocation="CenterScreen"
    Background="Transparent">

    <base:AvaloniaWindow.Styles>
        <!-- Kill default button chrome so selection pill alone provides the highlight -->
        <Style Selector="Button.top-nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.top-nav /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.top-nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.top-nav:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Border.nav-pill">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="36" />
        </Style>
        <Style Selector="Border.nav-pill:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.nav-pill.selected">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#EEC084FC" Offset="0" />
                    <GradientStop Color="#AA7C3AED" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <!-- Selected stays filled; unselected hover only tints the icon via button styles below -->
        <Style Selector="Button.top-nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.top-nav:pointerover ic|Lucide">
            <Setter Property="StrokeBrush" Value="#C084FC" />
        </Style>
        <Style Selector="Button.top-nav:pointerover TextBlock">
            <Setter Property="Foreground" Value="#C084FC" />
        </Style>
        <Style Selector="Border.nav-pill.selected:pointerover">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#F5E1FF" Offset="0" />
                    <GradientStop Color="#C084FC" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>
    </base:AvaloniaWindow.Styles>

    <Panel>
        <Border Background="#FF020510" />

        <controls:LiquidGlassPanel x:Name="ShellGlass"
                                   Margin="10"
                                   CornerRadius="26"
                                   TintOpacity="0.55"
                                   MaterialOpacity="0.72">
            <Panel>
                <!-- Abyss MUST be inside the shell — acrylic outside was fully covering it -->
                <controls:AbyssGlowBackground x:Name="AbyssBackground"
                                              ZIndex="0" />

                <controls:LiquidCursorOverlay x:Name="LiquidCursor"
                                              ZIndex="1"
                                              Opacity="0.45" />

                <Grid ZIndex="2" RowDefinitions="56,*,52" IsHitTestVisible="True">
                <Border Grid.Row="0"
                        BorderBrush="#22FFFFFF"
                        BorderThickness="0,0,0,1"
                        Background="#55080510">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="14,0,8,0">
                        <Panel Grid.Column="0" Grid.ColumnSpan="4"
                               WindowDecorationProperties.ElementRole="TitleBar"
                               Background="Transparent" />

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                                    VerticalAlignment="Center" Margin="2,0,18,0" IsHitTestVisible="False">
                            <controls:EclipseLogoMark Width="26" Height="26" />
                            <TextBlock Text="Eclipse" FontSize="16" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Foreground="#F3E8FF" />
                        </StackPanel>

                        <ItemsControl x:Name="RailItemsControl" Grid.Column="1" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:RailNavItem">
                                    <Button Classes="top-nav"
                                            Tag="{Binding Tag}"
                                            ToolTip.Tip="{Binding Title}"
                                            Click="RailItem_Click"
                                            IsVisible="{Binding IsVisible}">
                                        <!-- Single pill wraps icon+text — no separate stretch ghost -->
                                        <Border Classes="nav-pill"
                                                Classes.selected="{Binding IsSelected}">
                                            <StackPanel Orientation="Horizontal" Spacing="7"
                                                        VerticalAlignment="Center">
                                                <ic:Lucide Icon="{Binding Icon}" Width="15" Height="15"
                                                           VerticalAlignment="Center" StrokeBrush="#F8FAFC" />
                                                <TextBlock Text="{Binding Title}" FontSize="12.5"
                                                           FontWeight="SemiBold" Foreground="#F8FAFC"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Grid.Column="2"
                                MaxWidth="380" Height="34"
                                HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                CornerRadius="12"
                                Background="#22000000"
                                BorderBrush="#44A78BFA" BorderThickness="1"
                                Padding="2,0,8,0" Margin="12,0,8,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <elements:SearchBar DataContext="{Binding SearchBar}"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center" />
                                <Border Grid.Column="1" Padding="6,2" CornerRadius="7"
                                        Background="#33A855F7" VerticalAlignment="Center">
                                    <TextBlock Text="Ctrl K" FontSize="10" Foreground="#E9D5FF" />
                                </Border>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:IconButton Classes="TitleBarButton" Icon="Download"
                                                 ToolTip.Tip="Deployment" Click="TopDownload_Click" />
                            <controls:IconButton Classes="TitleBarButton" Icon="Bell"
                                                 ToolTip.Tip="News" Click="TopNews_Click" />
                            <controls:IconButton Name="PART_MinimizeButton" Classes="TitleBarButton" Icon="Minus" />
                            <controls:IconButton Name="PART_MaximizeButton" Classes="TitleBarButton" Icon="Maximize" />
                            <controls:IconButton Name="PART_CloseButton" Classes="TitleBarButton Close" Icon="X" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="24,14,24,0" IsVisible="{Binding ShowPageChrome}">
                        <ItemsControl IsVisible="{Binding HasBreadcrumbs}" ItemsSource="{Binding BreadcrumbItems}" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:BreadcrumbItemModel">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Padding="0" Background="Transparent" BorderThickness="0"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).BreadcrumbItemClickedCommand}"
                                                CommandParameter="{Binding}" Content="{Binding Content}"
                                                FontSize="18" FontWeight="SemiBold" IsVisible="{Binding !IsLast}" />
                                        <TextBlock Text="›" FontSize="18" Opacity="0.5" IsVisible="{Binding !IsLast}" />
                                        <TextBlock Text="{Binding Content}" FontSize="18" FontWeight="SemiBold" IsVisible="{Binding IsLast}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="PageTitleText" FontSize="22" FontWeight="SemiBold"
                                   IsVisible="{Binding ShowPageTitle}" Text="{Binding CurrentPageTitle}" />
                        <controls:MarkdownTextBlock x:Name="PageDescriptionText" Margin="0,4,0,0"
                                                    FontSize="13" Opacity="0.7"
                                                    IsVisible="{Binding CurrentPageDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                    MarkdownText="{Binding CurrentPageDescription}" />
                        <ui:FAInfoBar x:Name="AlertBar" Margin="0,8,0,0" IsVisible="False" Severity="Warning" />
                    </StackPanel>

                    <TransitioningContentControl Grid.Row="1" x:Name="PageContentControl"
                                                 HorizontalAlignment="Stretch"
                                                 VerticalAlignment="Stretch" />
                </Grid>

                <Border Grid.Row="2"
                        IsVisible="{Binding ShowFooter}"
                        BorderBrush="#22FFFFFF"
                        BorderThickness="0,1,0,0"
                        Background="#88080510"
                        Padding="14,0">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding VersionText}"
                                   FontSize="11"
                                   Foreground="#99C4B5FD"
                                   VerticalAlignment="Center" />
                        <controls:IconButton Grid.Column="1" Height="34" Padding="18,0"
                                             Classes="DropDownButton Primary"
                                             Command="{Binding SaveAndLaunchSettingsCommand}"
                                             Content="{Binding LaunchButtonText}">
                            <controls:IconButton.Flyout>
                                <MenuFlyout Placement="TopEdgeAlignedRight">
                                    <MenuItem Header="{Binding PlayerMenuItemText}" Command="{Binding SetLaunchModeCommand}"
                                              CommandParameter="{x:Static enums:LaunchMode.Player}">
                                        <MenuItem.Icon><ic:Lucide Icon="Gamepad2" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{x:Static resources:Strings.Common_Studio}" Command="{Binding SetLaunchModeCommand}"
                                              CommandParameter="{x:Static enums:LaunchMode.Studio}">
                                        <MenuItem.Icon><ic:Lucide Icon="Wrench" /></MenuItem.Icon>
                                    </MenuItem>
                                </MenuFlyout>
                            </controls:IconButton.Flyout>
                        </controls:IconButton>
                        <Button Grid.Column="2" Height="34" Padding="18,0" Classes="accent"
                                Command="{Binding RestartAppCommand}" Content="{x:Static resources:Strings.Menu_Restart}" />
                        <Button Grid.Column="3" Height="34" Padding="18,0" Classes="accent"
                                Command="{Binding SaveSettingsCommand}" Content="{x:Static resources:Strings.Menu_Save}" />
                        <Button Grid.Column="4" Height="34" Padding="18,0"
                                Command="{Binding CloseWindowCommand}" Content="{x:Static resources:Strings.Common_Close}" />
                    </Grid>
                </Border>
                </Grid>
            </Panel>
        </controls:LiquidGlassPanel>

        <Panel Name="NotificationPanel"
               Margin="0,0,0,20" VerticalAlignment="Bottom" ZIndex="1000" />

        <Border x:Name="OffscreenIndexingCanvas"
                Width="905" Height="700"
                IsHitTestVisible="False" IsVisible="False" Opacity="0" ZIndex="-1000" />
    </Panel>
</base:AvaloniaWindow>
