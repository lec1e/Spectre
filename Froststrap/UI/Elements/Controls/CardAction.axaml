<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Froststrap.UI.Elements.Controls"
        xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia">

    <Style Selector="controls|CardAction">
        <Setter Property="Foreground" Value="{DynamicResource WbFgBrush}" />
        <Setter Property="Background" Value="{DynamicResource WbSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WbLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="CornerRadius" Value="{DynamicResource WbRadius}" />
        <Setter Property="IconSize" Value="18" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Fill"
                        Margin="0,0,0,8"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="{TemplateBinding Padding}">
                        <Border Width="32" Height="32"
                                CornerRadius="{DynamicResource WbRadius}"
                                Background="{DynamicResource WbRaisedBrush}"
                                BorderBrush="{DynamicResource WbLineStrongBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <ic:Lucide Icon="{TemplateBinding Icon}"
                                       StrokeBrush="{DynamicResource WbFgBrush}"
                                       Width="{TemplateBinding IconSize}"
                                       Height="{TemplateBinding IconSize}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0"
                                    Spacing="2">
                            <TextBlock Text="{TemplateBinding Header}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource WbFgBrightBrush}" />
                            <controls:MarkdownTextBlock MarkdownText="{TemplateBinding Description}"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource WbFgMutedBrush}"
                                                        TextWrapping="Wrap"
                                                        IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                        <ic:Lucide Grid.Column="2"
                                   Icon="ChevronRight"
                                   Width="14" Height="14"
                                   Margin="12,0,0,0"
                                   StrokeBrush="{DynamicResource WbFgFaintBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|CardAction:pointerover /template/ Border#PART_Fill">
        <Setter Property="Background" Value="{DynamicResource WbRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WbLineStrongBrush}" />
    </Style>
    <Style Selector="controls|CardAction:pressed /template/ Border#PART_Fill">
        <Setter Property="Background" Value="{DynamicResource WbOverlayBrush}" />
    </Style>
</Styles>
