<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Froststrap.UI.Elements.Controls"
             xmlns:vm="clr-namespace:Froststrap.UI.ViewModels.Settings"
             x:Class="Froststrap.UI.Elements.Settings.Pages.AccountsPage"
             x:DataType="vm:AccountsViewModel"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
  <controls:FitHost>
    <Grid RowDefinitions="Auto,*">
      <controls:AccountStrip />
      <Grid Grid.Row="1" ColumnDefinitions="280,*" ColumnSpacing="14">
        <Border Background="{DynamicResource WbFillBrush}" BorderBrush="{DynamicResource WbLineStrongBrush}" BorderThickness="1" CornerRadius="16" Padding="12">
          <Grid RowDefinitions="Auto,*">
            <TextBlock Text="Saved accounts" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
            <controls:WheelScroll Grid.Row="1">
              <ItemsControl ItemsSource="{Binding Source={x:Static vm:AccountSession.Instance}, Path=Accounts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AccountCard">
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6" Padding="10,8"
                            Command="{Binding Source={x:Static vm:AccountSession.Instance}, Path=SelectCommand}"
                            CommandParameter="{Binding UserId}">
                      <StackPanel Spacing="1">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                          <TextBlock Text="now" FontSize="11" Opacity="0.7" IsVisible="{Binding IsActive}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Username, StringFormat='@{0}'}" FontSize="12" Opacity="0.6" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </controls:WheelScroll>
          </Grid>
        </Border>

        <Border Grid.Column="1" Background="#121216" BorderBrush="{DynamicResource WbLineStrongBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
          <controls:WheelScroll>
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="72,*" ColumnSpacing="14">
                <Border Width="64" Height="64" CornerRadius="12" ClipToBounds="True" Background="#0c0c0e">
                  <Image Source="{Binding Portrait}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="{Binding DisplayName}" FontSize="22" FontWeight="SemiBold" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Username}" Opacity="0.7" />
                    <TextBlock Text="{Binding UserIdText}" Opacity="0.55" />
                  </StackPanel>
                  <TextBlock Text="{Binding Presence}" Opacity="0.8" />
                  <TextBlock Text="{Binding Robux}" FontWeight="SemiBold" />
                </StackPanel>
              </Grid>

              <TextBlock Text="{Binding Counts}" Opacity="0.8" />

              <StackPanel Spacing="6">
                <TextBlock Text="About" FontWeight="SemiBold" />
                <Border Background="#0c0c0e" CornerRadius="10" Padding="12,10">
                  <TextBlock Text="{Binding About}" TextWrapping="Wrap" />
                </Border>
              </StackPanel>

              <TextBlock Text="Account" FontWeight="SemiBold" />
              <StackPanel Spacing="0">
                <Grid ColumnDefinitions="160,*" Margin="0,0,0,8">
                  <TextBlock Text="Joined" Opacity="0.65" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{Binding Joined}" />
                    <TextBlock Text="{Binding AccountAge}" Opacity="0.65" />
                  </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="160,*" Margin="0,0,0,8">
                  <TextBlock Text="Country" Opacity="0.65" />
                  <TextBlock Grid.Column="1" Text="{Binding Country}" />
                </Grid>
                <Grid ColumnDefinitions="160,*" Margin="0,0,0,8">
                  <TextBlock Text="Age group" Opacity="0.65" />
                  <TextBlock Grid.Column="1" Text="{Binding AgeGroup}" />
                </Grid>
                <Grid ColumnDefinitions="160,*" Margin="0,0,0,8">
                  <TextBlock Text="2-step verification" Opacity="0.65" />
                  <TextBlock Grid.Column="1" Text="{Binding TwoStep}" />
                </Grid>
                <Grid ColumnDefinitions="160,*" Margin="0,0,0,8">
                  <TextBlock Text="Voice chat" Opacity="0.65" />
                  <TextBlock Grid.Column="1" Text="{Binding Voice}" />
                </Grid>
                <Grid ColumnDefinitions="160,*">
                  <TextBlock Text="Primary group" Opacity="0.65" />
                  <TextBlock Grid.Column="1" Text="{Binding Group}" TextWrapping="Wrap" />
                </Grid>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Refresh" MinWidth="96" Command="{Binding RefreshCommand}" />
              </StackPanel>
              <TextBlock Text="{Binding Status}" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
          </controls:WheelScroll>
        </Border>
      </Grid>
    </Grid>
  </controls:FitHost>
</UserControl>
