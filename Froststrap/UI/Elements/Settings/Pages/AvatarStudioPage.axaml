<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Froststrap.UI.Elements.Controls"
             xmlns:vm="clr-namespace:Froststrap.UI.ViewModels.Settings"
             x:Class="Froststrap.UI.Elements.Settings.Pages.AvatarStudioPage"
             x:DataType="vm:AvatarStudioViewModel"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
  <UserControl.Styles>
    <Style Selector="ComboBox Popup">
      <Setter Property="Placement" Value="Bottom" />
      <Setter Property="PlacementConstraintAdjustment" Value="FlipY,ResizeY,SlideX" />
    </Style>
    <Style Selector="TextBox.speed">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="16" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Width" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.speed:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="TextBox.speed:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#55FFFFFF" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
  </UserControl.Styles>
  <controls:FitHost>
    <Grid RowDefinitions="Auto,*">
    <controls:AccountStrip />
    <Grid Grid.Row="1" ColumnDefinitions="340,*" ColumnSpacing="14">
      <Border Background="#121216" BorderBrush="{DynamicResource WbLineStrongBrush}" BorderThickness="1" CornerRadius="16">
        <Grid RowDefinitions="*,Auto">
          <Border Grid.Row="0" Margin="12,12,12,0" MinHeight="260" CornerRadius="12" ClipToBounds="True" Background="#0c0c0e">
            <controls:AccountStage x:Name="Stage" />
          </Border>
          <StackPanel Grid.Row="1" Margin="14" Spacing="8">
            <TextBlock Text="{Binding Heading}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Status}" Opacity="0.75" FontSize="12" TextWrapping="Wrap" />
            <ComboBox ItemsSource="{Binding Motions}" SelectedItem="{Binding Motion}" HorizontalAlignment="Stretch"
                      MaxDropDownHeight="220" DropDownOpened="FitDropDown" />
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
              <Button Content="{Binding PlayLabel}" MinWidth="72" Command="{Binding TogglePlayCommand}" />
              <TextBox Grid.Column="1" Classes="speed" VerticalAlignment="Center"
                       Text="{Binding SpeedText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
              <Slider Grid.Column="2" Minimum="0.25" Maximum="2" Value="{Binding Speed}" TickFrequency="0.25" VerticalAlignment="Center" />
              <Button Grid.Column="3" Content="My avatar" MinWidth="88" Command="{Binding ShowModelCommand}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Refresh" MinWidth="84" Command="{Binding RefreshCommand}" />
              <Button Content="Redraw" MinWidth="84" Command="{Binding RedrawCommand}" />
              <Button Content="Save 3D" MinWidth="84" Command="{Binding DownloadModelCommand}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="{DynamicResource WbFillBrush}" BorderBrush="{DynamicResource WbLineStrongBrush}" BorderThickness="1" CornerRadius="16" Padding="14">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Text="Wearing" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
          <controls:WheelScroll Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Groups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WornGroup">
                  <StackPanel Spacing="8" Margin="0,0,0,18">
                    <TextBlock Opacity="0.7" FontSize="12" FontWeight="SemiBold">
                      <Run Text="{Binding Title}" />
                      <Run Text="  " />
                      <Run Text="{Binding Items.Count}" />
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WornItemRow">
                          <Border Width="210" Margin="0,0,8,8" Padding="8" CornerRadius="12"
                                  Background="#121216" BorderBrush="{DynamicResource WbLineStrongBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                              <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0" Background="Transparent"
                                      Command="{Binding $parent[UserControl].((vm:AvatarStudioViewModel)DataContext).PreviewCommand}"
                                      CommandParameter="{Binding Id}">
                                <Grid ColumnDefinitions="52,*" ColumnSpacing="8">
                                  <Border Height="52" CornerRadius="8" ClipToBounds="True" Background="#0c0c0e">
                                    <Image Source="{Binding Image}" Stretch="Uniform" />
                                  </Border>
                                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12" />
                                    <TextBlock Text="{Binding TypeLabel}" FontSize="11" Opacity="0.55" />
                                  </StackPanel>
                                </Grid>
                              </Button>
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="3D" Padding="8,2" FontSize="11"
                                        Command="{Binding $parent[UserControl].((vm:AvatarStudioViewModel)DataContext).PreviewCommand}"
                                        CommandParameter="{Binding Id}" />
                                <Button Content="Download" Padding="8,2" FontSize="11"
                                        Command="{Binding $parent[UserControl].((vm:AvatarStudioViewModel)DataContext).DownloadFileCommand}"
                                        CommandParameter="{Binding Id}" />
                                <Button Content="Remove" Padding="8,2" FontSize="11"
                                        Command="{Binding $parent[UserControl].((vm:AvatarStudioViewModel)DataContext).RemoveCommand}"
                                        CommandParameter="{Binding Id}" />
                              </StackPanel>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </controls:WheelScroll>
        </Grid>
      </Border>
    </Grid>
    </Grid>
  </controls:FitHost>
</UserControl>
