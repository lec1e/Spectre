<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:converters="clr-namespace:Froststrap.UI.Converters"
        xmlns:controls="clr-namespace:Froststrap.UI.Elements.Controls">

    <Style Selector="controls|IconButton">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                <GradientStop Color="#E11D48" Offset="0" />
                <GradientStop Color="#4A1518" Offset="0.55" />
                <GradientStop Color="#000000" Offset="1" />
            </LinearGradientBrush>
        </Setter>
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="IconSize" Value="16" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Shadow"
                        Background="Transparent"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BoxShadow="0 8 22 0 #40000000">
                    <Border Name="PART_Clip"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True"
                            UseLayoutRounding="True"
                            BorderThickness="1">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                                <GradientStop Color="#55FFFFFF" Offset="0" />
                                <GradientStop Color="#33E11D48" Offset="0.45" />
                                <GradientStop Color="#22000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Panel>
                            <Border Name="PART_LayoutRoot"
                                    Background="{TemplateBinding Background}">
                                <Border.Transitions>
                                    <Transitions>
                                        <BrushTransition Property="Background" Duration="0:0:0.1" />
                                    </Transitions>
                                </Border.Transitions>
                            </Border>

                            <Border Name="PART_Sheen"
                                    IsHitTestVisible="False"
                                    Opacity="0.2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Color="#55FFFFFF" Offset="0" />
                                        <GradientStop Color="#10FFFFFF" Offset="0.3" />
                                        <GradientStop Color="#00000000" Offset="0.58" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Border Name="PART_Gloss"
                                    IsHitTestVisible="False"
                                    Height="14"
                                    VerticalAlignment="Top"
                                    Opacity="0.48">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                                        <GradientStop Color="#88FFFFFF" Offset="0" />
                                        <GradientStop Color="#22FFFFFF" Offset="0.55" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Border Name="PART_Depth"
                                    IsHitTestVisible="False"
                                    Height="10"
                                    VerticalAlignment="Bottom"
                                    Opacity="0.32">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#66000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="{TemplateBinding Padding}">
                                <ic:Lucide Icon="{TemplateBinding Icon}"
                                           StrokeBrush="{TemplateBinding Foreground}"
                                           Height="{TemplateBinding IconSize}"
                                           Width="{TemplateBinding IconSize}"
                                           VerticalAlignment="Center"
                                           IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"
                                                  Margin="8,0,0,0"
                                                  IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            </StackPanel>
                        </Panel>
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|IconButton:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#E11D48" Offset="0" />
                <GradientStop Color="#000000" Offset="1" />
            </LinearGradientBrush>
        </Setter>
    </Style>

    <Style Selector="controls|IconButton:pressed /template/ Border#PART_LayoutRoot">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#9F1239" Offset="0" />
                <GradientStop Color="#000000" Offset="1" />
            </LinearGradientBrush>
        </Setter>
    </Style>

    <!-- Title-bar / chrome icons: never show a hover fill — color the icon only -->
    <Style Selector="controls|IconButton.TitleBarButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="controls|IconButton.TitleBarButton /template/ Border#PART_Shadow">
        <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="controls|IconButton.TitleBarButton /template/ Border#PART_Gloss">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="controls|IconButton.TitleBarButton /template/ Border#PART_Sheen">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="controls|IconButton.TitleBarButton /template/ Border#PART_Depth">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="controls|IconButton.TitleBarButton /template/ Border#PART_Clip">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="controls|IconButton.TitleBarButton /template/ Border#PART_Rim">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="controls|IconButton.TitleBarButton:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="controls|IconButton.TitleBarButton:pressed /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="controls|IconButton.TitleBarButton:pointerover /template/ Border#PART_Gloss, controls|IconButton.TitleBarButton:pressed /template/ Border#PART_Gloss">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="controls|IconButton.TitleBarButton:pointerover /template/ Border#PART_Sheen, controls|IconButton.TitleBarButton:pressed /template/ Border#PART_Sheen">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="controls|IconButton.TitleBarButton:pointerover /template/ Border#PART_Clip, controls|IconButton.TitleBarButton:pressed /template/ Border#PART_Clip">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="controls|IconButton.TitleBarButton:pointerover /template/ Border#PART_Rim, controls|IconButton.TitleBarButton:pressed /template/ Border#PART_Rim">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="controls|IconButton.TitleBarButton:pointerover /template/ ic|Lucide">
        <Setter Property="StrokeBrush" Value="White" />
    </Style>
    <Style Selector="controls|IconButton.TitleBarButton:pressed /template/ ic|Lucide">
        <Setter Property="StrokeBrush" Value="White" />
    </Style>
    <Style Selector="controls|IconButton.TitleBarButton.Close:pointerover /template/ ic|Lucide">
        <Setter Property="StrokeBrush" Value="White" />
    </Style>
    <Style Selector="controls|IconButton.TitleBarButton.Close:pressed /template/ ic|Lucide">
        <Setter Property="StrokeBrush" Value="White" />
    </Style>

    <Style Selector="controls|IconButton:pointerover /template/ ic|Lucide">
        <Setter Property="StrokeBrush" Value="White" />
    </Style>

    <Style Selector="controls|IconButton:pressed /template/ ic|Lucide">
        <Setter Property="StrokeBrush" Value="White" />
    </Style>

    <Style Selector="controls|IconButton:disabled /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}" />
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <Style Selector="controls|IconButton.Danger:not(:disabled)">
        <Setter Property="Background" Value="#FF3B30" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="#E03026" />
    </Style>
    <Style Selector="controls|IconButton.Danger:not(:disabled):pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="#FF5247" />
    </Style>
    <Style Selector="controls|IconButton.Danger:disabled /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="#80FF3B30" />
        <Setter Property="BorderBrush" Value="#80E03026" />
    </Style>

    <Style Selector="controls|IconButton.Primary">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                <GradientStop Color="#E11D48" Offset="0" />
                <GradientStop Color="#4A1518" Offset="0.5" />
                <GradientStop Color="#000000" Offset="1" />
            </LinearGradientBrush>
        </Setter>
    </Style>
    <Style Selector="controls|IconButton.Primary:not(:disabled):pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                <GradientStop Color="#F43F5E" Offset="0" />
                <GradientStop Color="#E11D48" Offset="0.4" />
                <GradientStop Color="#000000" Offset="1" />
            </LinearGradientBrush>
        </Setter>
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="controls|IconButton.Primary:disabled /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundDisabled}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderBrushDisabled}" />
    </Style>

    <Style Selector="controls|IconButton.DropDownButton">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Shadow"
                        Background="Transparent"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BoxShadow="0 8 22 0 #40000000">
                    <Border Name="PART_Clip"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True"
                            UseLayoutRounding="True"
                            BorderThickness="1">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                                <GradientStop Color="#55FFFFFF" Offset="0" />
                                <GradientStop Color="#33E11D48" Offset="0.45" />
                                <GradientStop Color="#22000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Panel>
                            <Border Name="PART_LayoutRoot"
                                    Background="{TemplateBinding Background}">
                                <Border.Transitions>
                                    <Transitions>
                                        <BrushTransition Property="Background" Duration="0:0:0.1" />
                                    </Transitions>
                                </Border.Transitions>
                            </Border>

                            <Border Name="PART_Sheen"
                                    IsHitTestVisible="False"
                                    Opacity="0.2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Color="#55FFFFFF" Offset="0" />
                                        <GradientStop Color="#10FFFFFF" Offset="0.3" />
                                        <GradientStop Color="#00000000" Offset="0.58" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Border Name="PART_Gloss"
                                    IsHitTestVisible="False"
                                    Height="14"
                                    VerticalAlignment="Top"
                                    Opacity="0.48">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                                        <GradientStop Color="#88FFFFFF" Offset="0" />
                                        <GradientStop Color="#22FFFFFF" Offset="0.55" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Border Name="PART_Depth"
                                    IsHitTestVisible="False"
                                    Height="10"
                                    VerticalAlignment="Bottom"
                                    Opacity="0.32">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#66000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Grid ColumnDefinitions="*,Auto">
                                <Button Name="PART_PrimaryButton"
                                        Classes="chrome"
                                        Grid.Column="0"
                                        Template="{StaticResource SpectreGlassHitTemplate}"
                                        Background="Transparent"
                                        Foreground="{TemplateBinding Foreground}"
                                        BorderThickness="0"
                                        CornerRadius="0"
                                        Padding="{TemplateBinding Padding}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Command="{TemplateBinding Command}"
                                        CommandParameter="{TemplateBinding CommandParameter}">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                Spacing="8">
                                        <ic:Lucide Icon="{TemplateBinding Icon}"
                                                   StrokeBrush="{TemplateBinding Foreground}"
                                                   Height="{TemplateBinding IconSize}"
                                                   Width="{TemplateBinding IconSize}"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Center"
                                                          IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    </StackPanel>
                                </Button>

                                <Border Grid.Column="1"
                                        Width="1"
                                        Margin="0,10"
                                        HorizontalAlignment="Left"
                                        Background="#33FFFFFF"
                                        IsHitTestVisible="False"
                                        IsVisible="{TemplateBinding Flyout, Converter={x:Static ObjectConverters.IsNotNull}}" />

                                <Button Name="PART_SecondaryButton"
                                        Classes="chrome"
                                        Grid.Column="1"
                                        Template="{StaticResource SpectreGlassHitTemplate}"
                                        Background="Transparent"
                                        Foreground="{TemplateBinding Foreground}"
                                        BorderThickness="0"
                                        CornerRadius="0"
                                        Padding="14,0"
                                        MinWidth="40"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        IsVisible="{TemplateBinding Flyout, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <ic:Lucide Name="PART_Chevron"
                                               Icon="ChevronDown"
                                               StrokeBrush="{TemplateBinding Foreground}"
                                               Height="12"
                                               Width="12"
                                               VerticalAlignment="Center">
                                        <ic:Lucide.Transitions>
                                            <Transitions>
                                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
                                            </Transitions>
                                        </ic:Lucide.Transitions>
                                    </ic:Lucide>
                                </Button>
                            </Grid>
                        </Panel>
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    </Style>

    <Style Selector="controls|IconButton:pointerover /template/ Border#PART_Gloss">
        <Setter Property="Opacity" Value="0.82" />
    </Style>
    <Style Selector="controls|IconButton:pointerover /template/ Border#PART_Sheen">
        <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="controls|IconButton:pressed /template/ Border#PART_Gloss">
        <Setter Property="Opacity" Value="0.28" />
    </Style>
    <Style Selector="controls|IconButton:pressed /template/ Border#PART_Sheen">
        <Setter Property="Opacity" Value="0.12" />
    </Style>

    <Style Selector="controls|IconButton.DropDownButton:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#F43F5E" Offset="0" />
                <GradientStop Color="#E11D48" Offset="0.35" />
                <GradientStop Color="#000000" Offset="1" />
            </LinearGradientBrush>
        </Setter>
    </Style>
    <Style Selector="controls|IconButton.DropDownButton:pressed">
        <Setter Property="RenderTransform" Value="scale(0.985)" />
    </Style>
    <Style Selector="controls|IconButton.DropDownButton:disabled /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}" />
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <Style Selector="controls|IconButton.DropDownButton:flyout-open /template/ ic|Lucide#PART_Chevron">
        <Setter Property="RenderTransform" Value="rotate(180deg)" />
    </Style>

    <Style Selector="controls|IconButton.DropDownButton.Danger">
        <Setter Property="Background" Value="#FF3B30" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="controls|IconButton.DropDownButton.Danger:not(:disabled):pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="#FF5247" />
    </Style>
    <Style Selector="controls|IconButton.DropDownButton.Danger:disabled /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="#80FF3B30" />
    </Style>

    <Style Selector="controls|IconButton.DropDownButton.Primary">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                <GradientStop Color="#E8E11D48" Offset="0" />
                <GradientStop Color="#C44A1518" Offset="0.5" />
                <GradientStop Color="#F2000000" Offset="1" />
            </LinearGradientBrush>
        </Setter>
    </Style>
    <Style Selector="controls|IconButton.DropDownButton.Primary:not(:disabled):pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                <GradientStop Color="#F43F5E" Offset="0" />
                <GradientStop Color="#E11D48" Offset="0.4" />
                <GradientStop Color="#000000" Offset="1" />
            </LinearGradientBrush>
        </Setter>
    </Style>
    <Style Selector="controls|IconButton.DropDownButton.Primary:disabled /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundDisabled}" />
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource MenuFlyoutItemBackground}" />
    </Style>

    <Style Selector="MenuItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource MenuFlyoutItemBackgroundPointerOver}" />
    </Style>

    <Design.PreviewWith>
        <StackPanel Spacing="16" Background="{DynamicResource ApplicationPageBackgroundThemeBrush}">
            <StackPanel Spacing="8">
                <TextBlock Text="Default" FontWeight="Bold" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:IconButton Icon="House" Content="Home" />
                    <controls:IconButton Icon="Settings" Content="Settings" />
                    <controls:IconButton Icon="Trash2" Content="Delete" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Primary" FontWeight="Bold" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:IconButton Classes="Primary" Icon="Save" Content="Save" />
                    <controls:IconButton Classes="Primary" Icon="Plus" Content="Add" />
                    <controls:IconButton Classes="Primary" Icon="Check" Content="Confirm" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Danger" FontWeight="Bold" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:IconButton Classes="Danger" Icon="Trash2" Content="Delete" />
                    <controls:IconButton Classes="Danger" Icon="TriangleAlert" Content="Warning" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Disabled" FontWeight="Bold" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:IconButton IsEnabled="False" Icon="Settings" Content="Disabled" />
                    <controls:IconButton Classes="Primary" IsEnabled="False" Icon="Save" Content="Disabled" />
                    <controls:IconButton Classes="Danger" IsEnabled="False" Icon="Trash2" Content="Disabled" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Icon Only" FontWeight="Bold" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:IconButton Icon="House" />
                    <controls:IconButton Classes="Primary" Icon="Save" />
                    <controls:IconButton Classes="Danger" Icon="Trash2" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8" Margin="0,16,0,0">
                <TextBlock Text="DropDown Buttons (requires Flyout)" FontWeight="Bold" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:IconButton Classes="DropDownButton" Icon="Save" Content="Save" />
                    <controls:IconButton Classes="DropDownButton Primary" Icon="Plus" Content="Add" />
                    <controls:IconButton Classes="DropDownButton Danger" Icon="Trash2" Content="Delete" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <controls:IconButton Classes="DropDownButton" Icon="Save" Content="Disabled" IsEnabled="False" />
                    <controls:IconButton Classes="DropDownButton Primary" Icon="Plus" Content="Disabled" IsEnabled="False" />
                    <controls:IconButton Classes="DropDownButton Danger" Icon="Trash2" Content="Disabled" IsEnabled="False" />
                </StackPanel>
                <controls:IconButton Classes="DropDownButton" Icon="More" />
            </StackPanel>
        </StackPanel>
    </Design.PreviewWith>
</Styles>