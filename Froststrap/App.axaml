<Application
    x:Class="Froststrap.App"
    Name="Spectre"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
    xmlns:sty="using:FluentAvalonia.Styling"
    xmlns:converters="using:Froststrap.UI.Converters"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    RequestedThemeVariant="Dark">

    <Application.Styles>
        <sty:FluentAvaloniaTheme PreferSystemTheme="False" PreferUserAccentColor="False" />

        <StyleInclude Source="avares://Spectre/UI/Elements/Controls/Hyperlink.axaml" />
        <StyleInclude Source="avares://Spectre/UI/Elements/Controls/OptionControl.axaml" />
        <StyleInclude Source="avares://Spectre/UI/Elements/Controls/SquareCard.axaml" />
        <StyleInclude Source="avares://Spectre/UI/Elements/Controls/Card.axaml" />
        <StyleInclude Source="avares://Spectre/UI/Elements/Controls/CardExpander.axaml" />
        <StyleInclude Source="avares://Spectre/UI/Elements/Controls/TitleBar.axaml" />
        <StyleInclude Source="avares://Spectre/UI/Elements/Controls/IconButton.axaml" />

        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

        <StyleInclude Source="avares://Spectre/UI/AppThemes/Default.axaml" />
        <StyleInclude Source="avares://Spectre/UI/Elements/Controls/CardAction.axaml" />

        <Style Selector="ic|Lucide">
            <Setter Property="StrokeBrush" Value="{DynamicResource WbFgBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
        </Style>
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{DynamicResource WbFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource WbFgBrush}" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource WbFontFamily}" />
        </Style>
        <Style Selector="ui|FANavigationView /template/ Button#TogglePaneButton /template/ TextBlock#Icon">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="{DynamicResource WbFontFamily}" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontFamily" Value="{DynamicResource WbFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource WbFgBrush}" />
        </Style>
        <Style Selector="ToggleSwitch">
            <Setter Property="FontFamily" Value="{DynamicResource WbFontFamily}" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ColorPicker.AvaloniaUI/Templates/HueSlider.axaml" />
                <ResourceInclude Source="avares://ColorPicker.AvaloniaUI/Templates/SquareSlider.axaml" />
                <ResourceInclude Source="avares://ColorPicker.AvaloniaUI/Templates/SquarePicker.axaml" />
                <ResourceInclude Source="avares://LucideAvalonia/Lucide/ResourcesIcons.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <StaticResource x:Key="ToolTipBackground" ResourceKey="ToolTipBackgroundBrush" />
            <StaticResource x:Key="ToolTipForeground" ResourceKey="ToolTipForegroundBrush" />

            <FontFamily x:Key="Rubik">avares://Spectre/Resources/Fonts/Sora-VariableFont_wght.ttf#Sora</FontFamily>
            <FontFamily x:Key="SpectreFont">avares://Spectre/Resources/Fonts/Sora-VariableFont_wght.ttf#Sora</FontFamily>
            <FontFamily x:Key="WbMonoFont">Cascadia Mono, Consolas, monospace</FontFamily>
            <FontFamily x:Key="BuilderIconsRegular">avares://Spectre/Resources/Fonts#BuilderIcons-Regular</FontFamily>
            <FontFamily x:Key="BuilderIconsFilled">avares://Spectre/Resources/Fonts#BuilderIcons-Filled</FontFamily>

            <CornerRadius x:Key="WbRadius">8</CornerRadius>
            <CornerRadius x:Key="WbRadiusSmall">6</CornerRadius>
            <CornerRadius x:Key="WbRadiusLarge">12</CornerRadius>

            <converters:StringFormatConverter x:Key="StringFormatConverter" />
            <converters:EnumNameConverter x:Key="EnumNameConverter" />
            <converters:EnumToBoolConverter x:Key="EnumToBoolConverter" />
            <converters:NumberAbbreviationConverter x:Key="NumberAbbreviationConverter" />
            <converters:UrlToBitmapConverter x:Key="UrlToBitmapConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
