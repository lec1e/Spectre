<Application
    x:Class="Froststrap.App"
    Name="Spectre"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
    xmlns:sty="using:FluentAvalonia.Styling"
    xmlns:converters="using:Froststrap.UI.Converters"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    RequestedThemeVariant="Dark">

    <Application.Styles>
        <sty:FluentAvaloniaTheme PreferSystemTheme="True" PreferUserAccentColor="True" />

        <StyleInclude Source="avares://Eclipse/UI/Elements/Controls/Hyperlink.axaml" />
        <StyleInclude Source="avares://Eclipse/UI/Elements/Controls/OptionControl.axaml" />
        <StyleInclude Source="avares://Eclipse/UI/Elements/Controls/SquareCard.axaml" />
        <StyleInclude Source="avares://Eclipse/UI/Elements/Controls/Card.axaml" />
        <StyleInclude Source="avares://Eclipse/UI/Elements/Controls/CardExpander.axaml" />
        <StyleInclude Source="avares://Eclipse/UI/Elements/Controls/TitleBar.axaml" />
        <StyleInclude Source="avares://Eclipse/UI/Elements/Controls/CardAction.axaml" />
        <StyleInclude Source="avares://Eclipse/UI/Elements/Controls/IconButton.axaml" />
        <StyleInclude Source="avares://Eclipse/UI/Elements/Controls/LiquidGlassPanel.axaml" />

        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

        <StyleInclude Source="avares://Eclipse/UI/AppThemes/Default.axaml" />

        <Style Selector="ic|Lucide">
            <Setter Property="StrokeBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
        </Style>
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="avares://Eclipse/Resources/Fonts/Sora-VariableFont_wght.ttf#Sora" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="avares://Eclipse/Resources/Fonts/Sora-VariableFont_wght.ttf#Sora" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontFamily" Value="avares://Eclipse/Resources/Fonts/Sora-VariableFont_wght.ttf#Sora" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="avares://Eclipse/Resources/Fonts/Sora-VariableFont_wght.ttf#Sora" />
        </Style>
        <Style Selector="ToggleSwitch">
            <Setter Property="FontFamily" Value="avares://Eclipse/Resources/Fonts/Sora-VariableFont_wght.ttf#Sora" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ColorPicker.AvaloniaUI/Templates/HueSlider.axaml" />
                <ResourceInclude Source="avares://ColorPicker.AvaloniaUI/Templates/SquareSlider.axaml" />
                <ResourceInclude Source="avares://ColorPicker.AvaloniaUI/Templates/SquarePicker.axaml" />
                <ResourceInclude Source="avares://LucideAvalonia/Lucide/ResourcesIcons.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <StaticResource x:Key="ToolTipBackground" ResourceKey="ToolTipBackgroundBrush" />
            <StaticResource x:Key="ToolTipForeground" ResourceKey="ToolTipForegroundBrush" />

            <FontFamily x:Key="Rubik">avares://Eclipse/Resources/Fonts/Sora-VariableFont_wght.ttf#Sora</FontFamily>
            <FontFamily x:Key="SpectreFont">avares://Eclipse/Resources/Fonts/Sora-VariableFont_wght.ttf#Sora</FontFamily>
            <FontFamily x:Key="BuilderIconsRegular">avares://Eclipse/Resources/Fonts#BuilderIcons-Regular</FontFamily>
            <FontFamily x:Key="BuilderIconsFilled">avares://Eclipse/Resources/Fonts#BuilderIcons-Filled</FontFamily>

            <SolidColorBrush x:Key="BrandInkBrush" Color="#0A0406" />
            <SolidColorBrush x:Key="BrandAccentBrush" Color="#E11D48" />
            <SolidColorBrush x:Key="BrandHairlineBrush" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="GlassHeaderBrush" Color="#28C41E3A" />
            <SolidColorBrush x:Key="GlassRailBrush" Color="#3A7F1D1D" />
            <SolidColorBrush x:Key="GlassStageBrush" Color="#227F1D1D" />
            <SolidColorBrush x:Key="GlassFillBrush" Color="#557F1D1D" />
            <SolidColorBrush x:Key="GlassCardBrush" Color="#38C41E3A" />
            <SolidColorBrush x:Key="GlassBorderBrush" Color="#88FB7185" />

            <converters:StringFormatConverter x:Key="StringFormatConverter" />
            <converters:EnumNameConverter x:Key="EnumNameConverter" />
            <converters:EnumToBoolConverter x:Key="EnumToBoolConverter" />
            <converters:NumberAbbreviationConverter x:Key="NumberAbbreviationConverter" />
            <converters:UrlToBitmapConverter x:Key="UrlToBitmapConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>