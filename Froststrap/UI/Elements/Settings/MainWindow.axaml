<base:AvaloniaWindow
    x:Class="Froststrap.UI.Elements.Settings.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Froststrap.UI.Elements.Base"
    xmlns:util="clr-namespace:Froststrap.Utility"
    xmlns:controls="clr-namespace:Froststrap.UI.Elements.Controls"
    xmlns:elements="clr-namespace:Froststrap.UI.Elements"
    xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
    xmlns:enums="using:Froststrap.Enums"
    xmlns:models="using:Froststrap.Models"
    xmlns:resources="using:Froststrap.Resources"
    xmlns:transitions="clr-namespace:Froststrap.UI.Utility"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:vm="clr-namespace:Froststrap.UI.ViewModels.Settings"
    xmlns:app="clr-namespace:Froststrap"
    Title="{x:Static app:App.BrandName}"
    Icon="avares://Spectre/SpectreMark.png"
    Width="1200"
    Height="780"
    MinWidth="900"
    MinHeight="580"
    x:DataType="vm:MainWindowViewModel"
    CanResize="True"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource WbWindowBackgroundBrush}">

    <Panel>
        <controls:AnimatedBackground x:Name="Backdrop" />

        <Grid ColumnDefinitions="240,*">

            <!-- ===== Sidebar ===== -->
            <Border Grid.Column="0"
                    Background="{DynamicResource WbSidebarBrush}"
                    BorderBrush="{DynamicResource WbLineBrush}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,Auto,*,Auto">

                    <Panel Grid.Row="0" Height="64">
                        <Panel WindowDecorationProperties.ElementRole="TitleBar" Background="Transparent" />
                        <StackPanel Orientation="Horizontal" Spacing="11" Margin="18,6,0,0"
                                    VerticalAlignment="Center" IsHitTestVisible="False">
                            <controls:SpectreLogo Width="30" Height="30" Glow="0.6" />
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{x:Static app:App.BrandName}" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource WbLogoBrush}" />
                                <TextBlock Text="{Binding VersionText}" Classes="wb-faint" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </Panel>

                    <Border Grid.Row="1" Classes="sidebar-search" Margin="14,8,14,6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <elements:SearchBar x:Name="TitleSearchBar" DataContext="{Binding SearchBar}"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Classes="kbd">
                                <TextBlock Text="Ctrl K" FontSize="10" Foreground="{DynamicResource WbFgFaintBrush}" />
                            </Border>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="NavPanel" Margin="12,4,12,10" Spacing="2">
                            <controls:NavButton Tag="home" Icon="House" Text="Home" Click="Nav_Click" />

                            <TextBlock Classes="nav-section" Text="PLAY" />
                            <controls:NavButton Tag="quickplay" Icon="Gamepad2" Text="{x:Static resources:Strings.Menu_QuickPlay_Title}" Click="Nav_Click" />
                            <controls:NavButton Tag="regionselector" Icon="Globe" Text="Server Browser" Click="Nav_Click" />
                            <controls:NavButton Tag="vipserver" Icon="Crown" Text="VIP Server" Click="Nav_Click" />
                            <controls:NavButton Tag="multiinstance" Icon="Copy" Text="Multi Instance" Click="Nav_Click" />

                            <TextBlock Classes="nav-section" Text="ROBLOX" />
                            <controls:NavButton Tag="behaviour" Icon="Rocket" Text="{x:Static resources:Strings.Menu_Behaviour_Title}" Click="Nav_Click" />
                            <controls:NavButton Tag="integrations" Icon="Plug" Text="{x:Static resources:Strings.Menu_Integrations_Title}" Click="Nav_Click" />
                            <controls:NavButton Tag="channels" Icon="HardDriveUpload" Text="{x:Static resources:Strings.Common_Deployment}" Click="Nav_Click" />
                            <controls:NavButton Tag="versions" Icon="Layers" Text="Versions" Click="Nav_Click" />
                            <controls:NavButton Tag="fastflags" Icon="Flag" Text="{x:Static resources:Strings.Menu_FastFlags_Title}" Click="Nav_Click" />
                            <controls:NavButton x:Name="GbsNavItem" Tag="globalsettings" Icon="PenLine" Text="{x:Static resources:Strings.Menu_GlobalSettings_Title}" Click="Nav_Click" />
                            <controls:NavButton x:Name="LinuxNavItem" Tag="linuxsettings" Icon="Cpu" Text="{x:Static resources:Strings.Menu_LinuxSettings_Title}" Click="Nav_Click" />

                            <TextBlock Classes="nav-section" Text="CUSTOMIZE" />
                            <controls:NavButton Tag="appearance" Icon="Palette" Text="{x:Static resources:Strings.Menu_Appearance_Title}" Click="Nav_Click" />
                            <controls:NavButton Tag="mods" Icon="BookOpen" Text="{x:Static resources:Strings.Menu_PresetMods_Title}" Click="Nav_Click" />
                            <controls:NavButton Tag="custommods" Icon="Puzzle" Text="{x:Static resources:Strings.Menu_Mods_Title}" Click="Nav_Click" />
                            <controls:NavButton Tag="communitymods" Icon="Store" Text="{x:Static resources:Strings.Menu_CommunityMods_Title}" Click="Nav_Click" />
                            <controls:NavButton Tag="modgenerator" Icon="WandSparkles" Text="{x:Static resources:Strings.Menu_ModGenerator_Title}" Click="Nav_Click" />
                            <controls:NavButton Tag="shortcuts" Icon="Link2" Text="{x:Static resources:Strings.Common_Shortcuts}" Click="Nav_Click" />

                            <StackPanel x:Name="PrivacySection" Spacing="2">
                                <TextBlock Classes="nav-section" Text="PRIVACY" />
                                <controls:NavButton Tag="banasync" Icon="Shield" Text="BanAsync" Click="Nav_Click" />
                                <controls:NavButton Tag="hwidspoofer" Icon="FingerprintPattern" Text="HWID Spoofer" Click="Nav_Click" />
                            </StackPanel>

                            <TextBlock Classes="nav-section" Text="MORE" />
                            <controls:NavButton Tag="news" Icon="Newspaper" Text="News" Click="Nav_Click" />
                            <controls:NavButton Tag="about" Icon="Info" Text="{x:Static resources:Strings.Menu_About_Title}" Click="Nav_Click" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="3" Classes="sidebar-card" Margin="12,6,12,14">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Panel Width="30" Height="30" VerticalAlignment="Center">
                                <Border CornerRadius="15" Background="{DynamicResource WbFillBrush}" ClipToBounds="True">
                                    <Panel>
                                        <ic:Lucide Icon="User" Width="14" Height="14"
                                                   StrokeBrush="{DynamicResource WbFgFaintBrush}" />
                                        <Image x:Name="SessionAvatar" Stretch="UniformToFill" />
                                    </Panel>
                                </Border>
                                <Ellipse x:Name="CookieStatusDot" Width="9" Height="9"
                                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                         Stroke="{DynamicResource WbDeepBrush}" StrokeThickness="2"
                                         Fill="{DynamicResource WbFgFaintBrush}" />
                            </Panel>
                            <StackPanel x:Name="SessionText" Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock x:Name="SessionNameText" Text="Roblox session" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource WbFgBrightBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="CookieStatusText" Classes="wb-faint" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== Main column ===== -->
            <Grid Grid.Column="1" RowDefinitions="44,Auto,*,Auto">

                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
                    <Panel Grid.ColumnSpan="3" WindowDecorationProperties.ElementRole="TitleBar" Background="Transparent" />

                    <Button Grid.Column="1" Classes="wb-icon" ToolTip.Tip="Background" Margin="0,0,6,0"
                            VerticalAlignment="Center">
                        <ic:Lucide Icon="Palette" />
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="292" Spacing="6" Margin="2">
                                    <TextBlock Classes="wb-label" Text="BACKGROUND" Margin="4,2,0,2" />
                                    <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="BackgroundQuickList">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="util:SceneSpec">
                                                    <Button Classes="bg-quick" Click="QuickBackground_Click" Tag="{Binding Id}"
                                                            ToolTip.Tip="{Binding Name}">
                                                        <Border CornerRadius="6" ClipToBounds="True" Height="40">
                                                            <controls:AnimatedBackground SceneId="{Binding Id}" IsPreview="True"
                                                                                         IsAnimated="{Binding $parent[Button].IsPointerOver}" />
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <Separator Margin="0,2" />
                                    <Button Classes="wb-row" Click="OpenAppearance_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ic:Lucide Icon="SlidersHorizontal" Width="14" Height="14" />
                                            <TextBlock Text="All appearance settings" FontSize="13" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <controls:IconButton Name="PART_MinimizeButton" Classes="TitleBarButton" Icon="Minus" />
                        <controls:IconButton Name="PART_MaximizeButton" Classes="TitleBarButton" Icon="Maximize" />
                        <controls:IconButton Name="PART_CloseButton" Classes="TitleBarButton Close" Icon="X" />
                    </StackPanel>
                </Grid>

                <!-- Page header -->
                <StackPanel Grid.Row="1" x:Name="PageHeader" Margin="30,4,30,12" Spacing="6"
                            IsVisible="{Binding ShowPageHeader}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="38" Height="38" CornerRadius="11"
                                Background="{DynamicResource WbTileIconBrush}"
                                VerticalAlignment="Center">
                            <ic:Lucide Icon="{Binding CurrentPageIcon}" Width="18" Height="18"
                                       StrokeBrush="{DynamicResource WbAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <ItemsControl IsVisible="{Binding HasBreadcrumbs}"
                                      ItemsSource="{Binding BreadcrumbItems}"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:BreadcrumbItemModel">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Classes="section-link" FontSize="24" FontWeight="Bold"
                                                Padding="0"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).BreadcrumbItemClickedCommand}"
                                                CommandParameter="{Binding}" Content="{Binding Content}"
                                                IsVisible="{Binding !IsLast}" />
                                        <TextBlock Text="›" FontSize="24" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource WbFgFaintBrush}"
                                                   IsVisible="{Binding !IsLast}" />
                                        <TextBlock Text="{Binding Content}" FontSize="24" FontWeight="Bold"
                                                   Foreground="{DynamicResource WbFgBrightBrush}"
                                                   IsVisible="{Binding IsLast}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="PageTitleText" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource WbFgBrightBrush}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding ShowPageTitle}" Text="{Binding CurrentPageTitle}" />
                    </StackPanel>

                    <controls:MarkdownTextBlock x:Name="PageDescriptionText"
                                                FontSize="13" Margin="2,0,0,0"
                                                Foreground="{DynamicResource WbFgMutedBrush}"
                                                IsVisible="{Binding CurrentPageDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                MarkdownText="{Binding CurrentPageDescription}" />

                    <ui:FAInfoBar x:Name="AlertBar" Margin="0,6,0,0" IsOpen="False"
                                  IsClosable="False" Severity="Informational" />
                </StackPanel>

                <TransitioningContentControl Grid.Row="2" x:Name="PageContentControl"
                                             Margin="16,0,16,0"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch">
                    <TransitioningContentControl.PageTransition>
                        <transitions:FluentEntranceTransition VerticalOffset="40" Duration="0:0:0.28" />
                    </TransitioningContentControl.PageTransition>
                </TransitioningContentControl>

                <!-- Floating action dock -->
                <Border Grid.Row="3" Classes="action-dock" HorizontalAlignment="Right" Margin="0,6,24,18">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Classes="dock" Command="{Binding CloseWindowCommand}"
                                Content="{x:Static resources:Strings.Common_Close}" />
                        <Button Classes="dock" Command="{Binding RestartAppCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <ic:Lucide Icon="RefreshCw" Width="14" Height="14" />
                                <TextBlock Text="{x:Static resources:Strings.Menu_Restart}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="dock" Command="{Binding SaveSettingsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <ic:Lucide Icon="Check" Width="14" Height="14" />
                                <TextBlock Text="{x:Static resources:Strings.Menu_Save}" />
                            </StackPanel>
                        </Button>
                        <Rectangle Width="1" Height="20" Margin="2,0" VerticalAlignment="Center"
                                   Fill="{DynamicResource WbLineStrongBrush}" />
                        <controls:IconButton Height="36" Padding="18,0" CornerRadius="10"
                                             FontWeight="SemiBold"
                                             Classes="DropDownButton Primary"
                                             Command="{Binding SaveAndLaunchSettingsCommand}"
                                             Content="{Binding LaunchButtonText}">
                            <controls:IconButton.Flyout>
                                <MenuFlyout Placement="TopEdgeAlignedRight">
                                    <MenuItem Header="{Binding PlayerMenuItemText}" Command="{Binding SetLaunchModeCommand}"
                                              CommandParameter="{x:Static enums:LaunchMode.Player}">
                                        <MenuItem.Icon><ic:Lucide Icon="Gamepad2" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{x:Static resources:Strings.Common_Studio}" Command="{Binding SetLaunchModeCommand}"
                                              CommandParameter="{x:Static enums:LaunchMode.Studio}">
                                        <MenuItem.Icon><ic:Lucide Icon="Wrench" /></MenuItem.Icon>
                                    </MenuItem>
                                </MenuFlyout>
                            </controls:IconButton.Flyout>
                        </controls:IconButton>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Panel Name="NotificationPanel"
               Margin="240,0,0,84" VerticalAlignment="Bottom" ZIndex="1000" />

        <Border x:Name="OffscreenIndexingCanvas"
                Width="905" Height="700"
                IsHitTestVisible="False" IsVisible="False" Opacity="0" ZIndex="-1000" />
    </Panel>
</base:AvaloniaWindow>
