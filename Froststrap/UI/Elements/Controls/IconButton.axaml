<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
        xmlns:controls="clr-namespace:Froststrap.UI.Elements.Controls">

    <Style Selector="controls|IconButton">
        <Setter Property="Background" Value="{DynamicResource WbRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource WbFgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WbLineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="{DynamicResource WbRadius}" />
        <Setter Property="IconSize" Value="15" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_LayoutRoot"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.1" />
                        </Transitions>
                    </Border.Transitions>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="7"
                                Margin="{TemplateBinding Padding}">
                        <ic:Lucide Icon="{TemplateBinding Icon}"
                                   StrokeBrush="{TemplateBinding Foreground}"
                                   Height="{TemplateBinding IconSize}"
                                   Width="{TemplateBinding IconSize}"
                                   VerticalAlignment="Center"
                                   IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|IconButton:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource WbRaisedHoverBrush}" />
    </Style>
    <Style Selector="controls|IconButton:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource WbFgBrightBrush}" />
    </Style>
    <Style Selector="controls|IconButton:pressed /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource WbOverlayBrush}" />
    </Style>
    <Style Selector="controls|IconButton:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- Title-bar / chrome icons -->
    <Style Selector="controls|IconButton.TitleBarButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource WbFgMutedBrush}" />
    </Style>
    <Style Selector="controls|IconButton.TitleBarButton:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource WbHoverBrush}" />
    </Style>
    <Style Selector="controls|IconButton.TitleBarButton:pressed /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource WbActiveBrush}" />
    </Style>
    <Style Selector="controls|IconButton.TitleBarButton.Close:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="#C42B1C" />
    </Style>
    <Style Selector="controls|IconButton.TitleBarButton.Close:pointerover">
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Destructive -->
    <Style Selector="controls|IconButton.Danger">
        <Setter Property="Foreground" Value="{DynamicResource WbDangerBrush}" />
    </Style>
    <Style Selector="controls|IconButton.Danger:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource WbDangerSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WbDangerBrush}" />
    </Style>
    <Style Selector="controls|IconButton.Danger:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource WbDangerBrush}" />
    </Style>

    <Style Selector="controls|IconButton.ghost">
        <Setter Property="Background" Value="{DynamicResource WbFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WbLineStrongBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource WbFgBrush}" />
    </Style>
    <Style Selector="controls|IconButton.ghost:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource WbHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WbLineFocusBrush}" />
    </Style>
    <Style Selector="controls|IconButton.ghost:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource WbFgBrightBrush}" />
    </Style>

    <!-- Primary (solid accent) -->
    <Style Selector="controls|IconButton.Primary">
        <Setter Property="Background" Value="{DynamicResource WbAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WbAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource WbOnAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="controls|IconButton.Primary:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource WbAccentHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WbAccentHoverBrush}" />
    </Style>
    <Style Selector="controls|IconButton.Primary:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource WbOnAccentBrush}" />
    </Style>
    <Style Selector="controls|IconButton.Primary:pressed /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource WbAccentBrush}" />
    </Style>

    <!-- Split button: primary action + flyout chevron -->
    <Style Selector="controls|IconButton.DropDownButton">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_LayoutRoot"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="True">
                    <Grid ColumnDefinitions="*,Auto">
                        <Button Name="PART_PrimaryButton"
                                Grid.Column="0"
                                Template="{DynamicResource WbHitTemplate}"
                                Background="Transparent"
                                Foreground="{TemplateBinding Foreground}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Command="{TemplateBinding Command}"
                                CommandParameter="{TemplateBinding CommandParameter}">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Spacing="7">
                                <ic:Lucide Icon="{TemplateBinding Icon}"
                                           StrokeBrush="{TemplateBinding Foreground}"
                                           Height="{TemplateBinding IconSize}"
                                           Width="{TemplateBinding IconSize}"
                                           VerticalAlignment="Center"
                                           IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"
                                                  IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                        </Button>

                        <Border Grid.Column="1"
                                Width="1"
                                Margin="0,6"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                Opacity="0.25"
                                IsHitTestVisible="False"
                                IsVisible="{TemplateBinding Flyout, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        <Button Name="PART_SecondaryButton"
                                Grid.Column="1"
                                Template="{DynamicResource WbHitTemplate}"
                                Background="Transparent"
                                Foreground="{TemplateBinding Foreground}"
                                BorderThickness="0"
                                Padding="10,0"
                                MinWidth="32"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                IsVisible="{TemplateBinding Flyout, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <ic:Lucide Name="PART_Chevron"
                                       Icon="ChevronDown"
                                       StrokeBrush="{TemplateBinding Foreground}"
                                       Height="12"
                                       Width="12"
                                       VerticalAlignment="Center">
                                <ic:Lucide.Transitions>
                                    <Transitions>
                                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                                    </Transitions>
                                </ic:Lucide.Transitions>
                            </ic:Lucide>
                        </Button>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|IconButton.DropDownButton:flyout-open /template/ ic|Lucide#PART_Chevron">
        <Setter Property="RenderTransform" Value="rotate(180deg)" />
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource WbFgBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="MenuItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource WbHoverBrush}" />
    </Style>
</Styles>
