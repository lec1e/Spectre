<base:AvaloniaWindow x:Class="Froststrap.UI.Elements.Dialogs.ConnectivityDialog"
                     xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:base="clr-namespace:Froststrap.UI.Elements.Base"
                     xmlns:md="clr-namespace:Froststrap.UI.Elements.Controls"
                     xmlns:resources="clr-namespace:Froststrap.Resources"
                     mc:Ignorable="d"
                     Width="480"
                     SizeToContent="Height"
                     Title="{x:Static resources:Strings.Dialog_Connectivity_Title}"
                     WindowStartupLocation="CenterScreen"
                     Background="{DynamicResource WbWindowBackgroundBrush}">

    <Panel>
        <md:AnimatedBackground x:Name="Backdrop" />
        <Panel ClipToBounds="True">
            <Panel>
                <Grid RowDefinitions="Auto,*,Auto">
                    <md:TitleBar Grid.Row="0" ShowMinimize="False" ShowMaximize="False"
                                 Title="{x:Static resources:Strings.Dialog_Connectivity_Title}"
                                 Icon="avares://Spectre/SpectreMark.png" />

                    <Grid Grid.Row="1" Margin="22,12,22,8" ColumnDefinitions="Auto,*">
                        <Image x:Name="IconImage" Grid.Column="0" Width="32" Height="32"
                               Margin="0,0,15,0" VerticalAlignment="Top"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />

                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="TitleTextBlock" Text="? is unable to connect to ?"
                                       FontSize="18" TextWrapping="Wrap" Foreground="{DynamicResource WbFgBrush}" />

                            <md:MarkdownTextBlock x:Name="DescriptionMarkdownTextBlock"
                                                  MarkdownText="?" Margin="0,16,0,0"
                                                  TextWrapping="Wrap" Foreground="{DynamicResource WbFgBrush}" />

                            <TextBlock Text="{x:Static resources:Strings.Dialog_Connectivity_MoreInfo}"
                                       Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{DynamicResource WbFgBrush}" />

                            <TextBox x:Name="ErrorTextBox" Padding="8" Margin="0,8,0,0"
                                     FontFamily="Courier New" IsReadOnly="True"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Height="120" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="22,8,22,18">
                        <md:IconButton x:Name="CloseButton" MinWidth="100" Height="38" CornerRadius="14"
                                       Classes="Primary" Icon="X" IconSize="16" Padding="16,0"
                                       Content="{x:Static resources:Strings.Common_Close}" />
                    </StackPanel>
                </Grid>
            </Panel>
        </Panel>
    </Panel>
</base:AvaloniaWindow>
