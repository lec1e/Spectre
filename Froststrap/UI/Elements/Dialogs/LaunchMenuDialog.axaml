<base:AvaloniaWindow x:Class="Froststrap.UI.Elements.Dialogs.LaunchMenuDialog"
                     xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:base="clr-namespace:Froststrap.UI.Elements.Base"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:controls="clr-namespace:Froststrap.UI.Elements.Controls"
                     xmlns:resources="clr-namespace:Froststrap.Resources"
                     xmlns:vm="clr-namespace:Froststrap.UI.ViewModels.Dialogs"
                     xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
                     xmlns:enums="clr-namespace:Froststrap.Enums"
                     xmlns:app="clr-namespace:Froststrap"
                     x:DataType="vm:LaunchMenuViewModel"
                     Title="{x:Static app:App.BrandName}"
                     Width="468"
                     Height="440"
                     MinWidth="468"
                     MaxWidth="468"
                     MinHeight="440"
                     MaxHeight="440"
                     SizeToContent="Manual"
                     CanResize="False"
                     Background="{DynamicResource WbWindowBackgroundBrush}"
                     WindowStartupLocation="CenterScreen"
                     mc:Ignorable="d">

    <Panel>
        <controls:AnimatedBackground x:Name="Backdrop" />

        <Grid RowDefinitions="36,*,Auto">
            <Panel Grid.Row="0">
                <Panel WindowDecorationProperties.ElementRole="TitleBar" Background="Transparent" />
                <controls:IconButton Classes="TitleBarButton Close"
                                     HorizontalAlignment="Right"
                                     Icon="X"
                                     Click="Close_Click" />
            </Panel>

            <StackPanel Grid.Row="1" Margin="28,4,28,0" Spacing="18">
                <StackPanel HorizontalAlignment="Center" Spacing="10">
                    <controls:SpectreLogo Width="72" Height="72" Glow="0.7" HorizontalAlignment="Center" />
                    <StackPanel HorizontalAlignment="Center" Spacing="2">
                        <TextBlock Name="LaunchTitle" Text="{x:Static app:App.BrandName}"
                                   FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource WbLogoBrush}" />
                        <TextBlock Text="{Binding Version}" FontSize="12.5" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource WbFgMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <controls:IconButton Grid.Column="0"
                                             Classes="DropDownButton Primary"
                                             HorizontalAlignment="Stretch"
                                             Height="48"
                                             CornerRadius="14"
                                             Command="{Binding LaunchCommand}"
                                             IconSize="18"
                                             Icon="{Binding LaunchButtonIcon}"
                                             Content="{Binding LaunchButtonText}"
                                             Padding="16,0">
                            <controls:IconButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="{Binding PlayerMenuItemText}"
                                              Command="{Binding SetLaunchModeCommand}"
                                              CommandParameter="{x:Static enums:LaunchMode.Player}">
                                        <MenuItem.Icon>
                                            <ic:Lucide Icon="Gamepad2" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{x:Static resources:Strings.Common_Studio}"
                                              Command="{Binding SetLaunchModeCommand}"
                                              CommandParameter="{x:Static enums:LaunchMode.Studio}">
                                        <MenuItem.Icon>
                                            <ic:Lucide Icon="Wrench" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </MenuFlyout>
                            </controls:IconButton.Flyout>
                        </controls:IconButton>

                        <controls:IconButton Grid.Column="1"
                                             Classes="ghost"
                                             Height="48"
                                             MinWidth="132"
                                             CornerRadius="14"
                                             IconSize="16"
                                             Icon="RefreshCw"
                                             Content="Reinstall"
                                             Padding="14,0"
                                             IsEnabled="{Binding CanReinstall}"
                                             Command="{Binding ReinstallRobloxCommand}" />
                    </Grid>

                    <controls:IconButton Classes="ghost"
                                         HorizontalAlignment="Stretch"
                                         Height="44"
                                         CornerRadius="14"
                                         IconSize="16"
                                         Icon="Settings"
                                         Content="{x:Static resources:Strings.Common_Settings}"
                                         Padding="16,0"
                                         Command="{Binding LaunchSettingsCommand}" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="2" Margin="28,8,28,22" Padding="12,9"
                    CornerRadius="12"
                    Background="{DynamicResource WbFillBrush}"
                    BorderBrush="{DynamicResource WbLineBrush}" BorderThickness="1">
                <TextBlock Text="Backgrounds, glass and accent all live in Appearance."
                           FontSize="11.5" TextAlignment="Center"
                           Foreground="{DynamicResource WbFgFaintBrush}" />
            </Border>
        </Grid>
    </Panel>
</base:AvaloniaWindow>
