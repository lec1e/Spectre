<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
             xmlns:vm="clr-namespace:Froststrap.UI.ViewModels.Settings"
             x:Class="Froststrap.UI.Elements.Settings.Pages.HomeDashboardPage"
             x:DataType="vm:HomeDashboardViewModel"
             Background="Transparent">

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="28,20,28,28" Spacing="28">

      <!-- HERO — open, no boxed card -->
      <StackPanel Spacing="8" MaxWidth="640">
        <TextBlock Text="{Binding Greeting}" FontSize="13" FontWeight="Medium"
                   Foreground="#B8A0D8" />
        <TextBlock Text="{Binding DisplayName}" FontSize="38" FontWeight="Bold"
                   Margin="0,-4,0,0">
          <TextBlock.Foreground>
            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
              <GradientStop Color="#F8F0FF" Offset="0" />
              <GradientStop Color="#C084FC" Offset="0.45" />
              <GradientStop Color="#67E8F9" Offset="1" />
            </LinearGradientBrush>
          </TextBlock.Foreground>
        </TextBlock>
        <TextBlock Text="{Binding Tagline}" FontSize="14"
                   Foreground="#9B8AB8" TextWrapping="Wrap" MaxWidth="480" />

        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,12,0,0">
          <Button Classes="eclipse-primary" Width="160" Height="42" Padding="0" CornerRadius="12"
                  BorderThickness="0" Command="{Binding LaunchRobloxCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
              <ic:Lucide Icon="Play" Width="15" Height="15" StrokeBrush="White" />
              <TextBlock Text="Launch Roblox" FontWeight="SemiBold" Foreground="White" />
            </StackPanel>
          </Button>
          <Button Classes="eclipse-ghost" Width="140" Height="42" Padding="0" CornerRadius="12"
                  Command="{Binding OpenFolderCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
              <ic:Lucide Icon="Folder" Width="15" Height="15" StrokeBrush="#E9D5FF" />
              <TextBlock Text="Open Folder" Foreground="#E9D5FF" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>

      <!-- RECENTLY PLAYED -->
      <StackPanel Spacing="14">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Recently Played" FontSize="15" FontWeight="SemiBold" Foreground="#F3E8FF" />
          <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0"
                  Command="{Binding OpenQuickPlayCommand}">
            <TextBlock Text="View all" FontSize="12.5" Foreground="#C084FC" />
          </Button>
        </Grid>

        <Border IsVisible="{Binding HasNoRecentGames}" Height="88" CornerRadius="14"
                Background="#33000000" BorderBrush="#22FFFFFF" BorderThickness="1" Padding="16">
          <StackPanel VerticalAlignment="Center" Spacing="3">
            <TextBlock Text="No recent games yet" FontSize="13.5" FontWeight="SemiBold" Foreground="#E9D5FF" />
            <TextBlock Text="Play with Eclipse tracking on to build your history."
                       FontSize="12" Foreground="#8B7AA8" />
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding RecentGames}" IsVisible="{Binding HasRecentGames}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="4" Rows="1" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HomeGameCard">
              <Border Height="136" Margin="0,0,10,0" CornerRadius="14" ClipToBounds="True"
                      BorderBrush="#33FFFFFF" BorderThickness="1">
                <Panel>
                  <Border Background="{Binding TintBrush}" />
                  <Image Stretch="UniformToFill" IsVisible="{Binding HasImage}"
                         Source="{Binding ImageUrl, Converter={StaticResource UrlToBitmapConverter}}" />
                  <Border>
                    <Border.Background>
                      <LinearGradientBrush StartPoint="50%,30%" EndPoint="50%,100%">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#F00A0612" Offset="1" />
                      </LinearGradientBrush>
                    </Border.Background>
                  </Border>
                  <Grid Margin="11" ColumnDefinitions="*,Auto" VerticalAlignment="Bottom">
                    <StackPanel Spacing="2" Margin="0,0,6,0">
                      <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                 Foreground="White" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="#C4B5FD" Opacity="0.8" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="eclipse-primary" Width="30" Height="30" Padding="0" CornerRadius="15"
                            BorderThickness="0" VerticalAlignment="Bottom"
                            Command="{Binding $parent[UserControl].((vm:HomeDashboardViewModel)DataContext).PlayPlaceCommand}"
                            CommandParameter="{Binding PlaceId}">
                      <ic:Lucide Icon="Play" Width="12" Height="12" StrokeBrush="White"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                  </Grid>
                </Panel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- FEATURED | NEWS — lighter panels, less visual noise -->
      <Grid ColumnDefinitions="1.35*,*" ColumnSpacing="20" MinHeight="240">
        <StackPanel Grid.Column="0" Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Featured" FontSize="15" FontWeight="SemiBold" Foreground="#F3E8FF" />
            <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0"
                    Command="{Binding OpenQuickPlayCommand}">
              <TextBlock Text="Explore" FontSize="12.5" Foreground="#C084FC" />
            </Button>
          </Grid>

          <ItemsControl ItemsSource="{Binding FeaturedGames}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HomeFeaturedItem">
                <Border Margin="0,0,0,8" Padding="10" CornerRadius="12"
                        Background="#28000000" BorderBrush="#18FFFFFF" BorderThickness="1">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Width="72" Height="48" CornerRadius="9" ClipToBounds="True" Background="#22000000">
                      <Panel>
                        <Border Background="{Binding TintBrush}" />
                        <Image Stretch="UniformToFill" IsVisible="{Binding HasImage}"
                               Source="{Binding ImageUrl, Converter={StaticResource UrlToBitmapConverter}}" />
                      </Panel>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                 Foreground="#F1F5F9" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#8B7AA8"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="eclipse-ghost" Height="30" MinWidth="64" Padding="10,0"
                            CornerRadius="9" VerticalAlignment="Center"
                            BorderBrush="#88A855F7" BorderThickness="1"
                            Foreground="#E9D5FF" Content="Play" FontWeight="SemiBold" FontSize="12"
                            Command="{Binding $parent[UserControl].((vm:HomeDashboardViewModel)DataContext).PlayPlaceCommand}"
                            CommandParameter="{Binding PlaceId}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="News" FontSize="15" FontWeight="SemiBold" Foreground="#F3E8FF" />
            <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0"
                    Command="{Binding OpenNewsCommand}">
              <TextBlock Text="All" FontSize="12.5" Foreground="#C084FC" />
            </Button>
          </Grid>

          <ItemsControl ItemsSource="{Binding NewsItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HomeNewsItem">
                <Border Margin="0,0,0,6" Padding="10,9" CornerRadius="11"
                        Background="#22000000">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Border Width="32" Height="32" CornerRadius="9">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                          <GradientStop Color="#A855F7" Offset="0" />
                          <GradientStop Color="#4F46E5" Offset="1" />
                        </LinearGradientBrush>
                      </Border.Background>
                      <ic:Lucide Icon="{Binding Icon}" Width="14" Height="14" StrokeBrush="White"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5"
                                 Foreground="#F1F5F9" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#8B7AA8"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding When}" FontSize="10.5"
                               Foreground="#7C6B99" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
