<base:AvaloniaWindow
    x:Class="Froststrap.UI.Elements.Dialogs.UninstallerDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Froststrap.UI.Elements.Base"
    xmlns:resources="using:Froststrap.Resources"
    xmlns:controls="clr-namespace:Froststrap.UI.Elements.Controls"
    xmlns:vm="clr-namespace:Froststrap.UI.ViewModels.Dialogs"
    xmlns:app="clr-namespace:Froststrap"
    Title="{x:Static resources:Strings.Uninstaller_Title}"
    Width="480"
    MinWidth="480"
    MaxWidth="480"
    SizeToContent="Height"
    x:DataType="vm:UninstallerViewModel"
    Background="Transparent"
    WindowStartupLocation="CenterScreen">

    <Panel>
        <controls:LiquidGlassPanel x:Name="ShellGlass"
                                   Margin="0"
                                   CornerRadius="0"
                                   TintOpacity="0.58"
                                   MaterialOpacity="0.46"
                                   UseSettingsCornerRadius="False"
                                   ClipToBounds="True">
            <Panel>
                <controls:AbyssGlowBackground x:Name="AbyssBackground" />
                <Grid RowDefinitions="Auto,*,Auto">
                    <controls:TitleBar Grid.Row="0"
                                       Title=""
                                       Icon="{x:Null}"
                                       ShowMinimize="False"
                                       ShowMaximize="False" />

                    <StackPanel Grid.Row="1" Margin="28,8,28,16">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="14" Margin="0,0,0,18">
                            <Border Width="56" Height="56" CornerRadius="16" ClipToBounds="True">
                                <Image Width="56" Height="56" Source="avares://Spectre/SpectreMark.png"
                                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock Text="{x:Static app:App.BrandName}" FontSize="24" FontWeight="Bold"
                                           Foreground="White" />
                                <TextBlock Text="{Binding Version}" FontSize="12.5" Foreground="White" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="White"
                                   Text="{x:Static resources:Strings.Uninstaller_Title}" />
                        <controls:MarkdownTextBlock FontSize="14" Margin="0,8,0,16" Foreground="White"
                                                    MarkdownText="{Binding Text, Mode=OneTime}" TextWrapping="Wrap" />
                        <CheckBox Content="{x:Static resources:Strings.Uninstaller_KeepData_Label}"
                                  IsChecked="{Binding KeepData, Mode=TwoWay}"
                                  Foreground="White" />
                        <TextBlock FontSize="13" Margin="0,6,0,0" Foreground="#CCFFFFFF" TextWrapping="Wrap"
                                   Text="{x:Static resources:Strings.Uninstaller_KeepData_Description}"
                                   IsVisible="{Binding KeepData, Mode=OneWay}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                Spacing="10" Margin="28,0,28,24">
                        <controls:IconButton Classes="Primary"
                                             MinWidth="120"
                                             Height="40"
                                             CornerRadius="14"
                                             Icon="Trash2"
                                             IconSize="16"
                                             Padding="16,0"
                                             Content="{x:Static resources:Strings.Uninstaller_Uninstall}"
                                             Command="{Binding ConfirmUninstallCommand}" />
                        <controls:IconButton Classes="Primary"
                                             MinWidth="120"
                                             Height="40"
                                             CornerRadius="14"
                                             Icon="X"
                                             IconSize="16"
                                             Padding="16,0"
                                             Content="{x:Static resources:Strings.Common_Cancel}"
                                             Command="{Binding CancelCommand}" />
                    </StackPanel>
                </Grid>
            </Panel>
        </controls:LiquidGlassPanel>
    </Panel>
</base:AvaloniaWindow>
