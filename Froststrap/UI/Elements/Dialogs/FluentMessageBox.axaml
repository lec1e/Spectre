<base:AvaloniaWindow x:Class="Froststrap.UI.Elements.Dialogs.FluentMessageBox"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:base="clr-namespace:Froststrap.UI.Elements.Base"
        xmlns:controls="clr-namespace:Froststrap.UI.Elements.Controls"
        xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
        xmlns:app="clr-namespace:Froststrap"
        Title="{x:Static app:App.BrandName}"
        Width="440" MinWidth="400" MaxWidth="520"
        SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WbWindowBackgroundBrush}">

    <Panel>
        <controls:AnimatedBackground x:Name="Backdrop" />

        <Grid RowDefinitions="36,*,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="14,0,0,0">
                <Panel WindowDecorationProperties.ElementRole="TitleBar" Background="Transparent" />
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsHitTestVisible="False">
                    <controls:SpectreLogo Width="18" Height="18" Glow="0.4" />
                    <TextBlock Text="{x:Static app:App.BrandName}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource WbLogoBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <controls:IconButton Grid.Column="1" Classes="TitleBarButton Close"
                                     Icon="X" Click="Close_Click" />
            </Grid>

            <Grid Grid.Row="1" Margin="24,4,24,8" ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Width="40" Height="40" CornerRadius="12"
                        Background="{DynamicResource WbAccentSoftBrush}"
                        VerticalAlignment="Top">
                    <Panel>
                        <ic:Lucide x:Name="GlyphIcon"
                                   Width="18" Height="18"
                                   Icon="CircleQuestionMark"
                                   StrokeBrush="{DynamicResource WbAccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <Image x:Name="IconImage" Width="20" Height="20" IsVisible="False"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Panel>
                </Border>

                <controls:MarkdownTextBlock x:Name="MessageMarkdownTextBlock" Grid.Column="1"
                                      VerticalAlignment="Center"
                                      TextWrapping="Wrap"
                                      FontSize="14"
                                      Foreground="{DynamicResource WbFgBrightBrush}" />
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        Spacing="8" Margin="24,4,24,20">
                <controls:IconButton x:Name="ButtonOne"
                        Classes="Primary"
                        MinWidth="92" Height="38" CornerRadius="12"
                        Padding="16,0"
                        Content="Button 1"
                        IsVisible="False" />
                <controls:IconButton x:Name="ButtonTwo"
                        Classes="ghost"
                        MinWidth="92" Height="38" CornerRadius="12"
                        Padding="16,0"
                        Content="Button 2"
                        IsVisible="False" />
                <controls:IconButton x:Name="ButtonThree"
                        Classes="ghost"
                        MinWidth="92" Height="38" CornerRadius="12"
                        Padding="16,0"
                        Content="Button 3"
                        IsVisible="False" />
            </StackPanel>
        </Grid>
    </Panel>
</base:AvaloniaWindow>
