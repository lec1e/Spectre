<base:AvaloniaWindow
    x:Class="Froststrap.UI.Elements.Settings.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Froststrap.UI.Elements.Base"
    xmlns:controls="clr-namespace:Froststrap.UI.Elements.Controls"
    xmlns:elements="clr-namespace:Froststrap.UI.Elements"
    xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
    xmlns:local="clr-namespace:Froststrap.UI.Elements.Settings"
    xmlns:enums="using:Froststrap.Enums"
    xmlns:resources="using:Froststrap.Resources"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:vm="clr-namespace:Froststrap.UI.ViewModels.Settings"
    xmlns:app="clr-namespace:Froststrap"
    Title="{x:Static app:App.BrandName}"
    Icon="avares://Eclipse/SpectreMark.png"
    Width="1280"
    Height="800"
    MinWidth="1080"
    MinHeight="680"
    x:DataType="vm:MainWindowViewModel"
    CanResize="True"
    WindowStartupLocation="CenterScreen"
    Background="Transparent">

    <base:AvaloniaWindow.Styles>
        <!-- Kill default button chrome so selection pill alone provides the highlight -->
        <Style Selector="Button.top-nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.top-nav /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.top-nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.top-nav:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Border.nav-pill">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>
        <Style Selector="Border.nav-pill:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.nav-pill.selected">
            <Setter Property="BorderBrush">
                <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                    <GradientStop Color="#55FFFFFF" Offset="0" />
                    <GradientStop Color="#33E11D48" Offset="0.45" />
                    <GradientStop Color="#22000000" Offset="1" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BoxShadow" Value="0 6 16 0 #40000000" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                    <GradientStop Color="#E8E11D48" Offset="0" />
                    <GradientStop Color="#C44A1518" Offset="0.5" />
                    <GradientStop Color="#F2000000" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Border.nav-pill Border.nav-gloss">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border.nav-pill Border.nav-sheen">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border.nav-pill.selected Border.nav-gloss">
            <Setter Property="Opacity" Value="0.48" />
        </Style>
        <Style Selector="Border.nav-pill.selected Border.nav-sheen">
            <Setter Property="Opacity" Value="0.2" />
        </Style>
        <!-- Selected stays filled; unselected hover only tints the icon via button styles below -->
        <Style Selector="Button.top-nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.top-nav:pointerover /template/ Border#PART_Fill">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.top-nav:pointerover ic|Lucide">
            <Setter Property="StrokeBrush" Value="White" />
        </Style>
        <Style Selector="Button.top-nav:pointerover TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Border.nav-pill.selected:pointerover">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                    <GradientStop Color="#F43F5E" Offset="0" />
                    <GradientStop Color="#E11D48" Offset="0.35" />
                    <GradientStop Color="#000000" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Border.nav-pill.selected:pointerover Border.nav-gloss">
            <Setter Property="Opacity" Value="0.82" />
        </Style>
    </base:AvaloniaWindow.Styles>

    <Panel>
        <controls:LiquidGlassPanel x:Name="ShellGlass"
                                   Margin="0"
                                   CornerRadius="0"
                                   TintOpacity="0.58"
                                   MaterialOpacity="0.46"
                                   UseSettingsCornerRadius="False"
                                   ClipToBounds="False">
            <Panel>
                <!-- Marble veins sit ON the acrylic; pointer parallax moves them. -->
                <controls:AbyssGlowBackground x:Name="AbyssBackground"
                                              ZIndex="0" />

                <Grid ZIndex="2" RowDefinitions="56,*,52" IsHitTestVisible="True">
                <Border Grid.Row="0"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Background="#661A060A">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="16,0,10,0" ColumnSpacing="12">
                        <Panel Grid.Column="0" Grid.ColumnSpan="4"
                               WindowDecorationProperties.ElementRole="TitleBar"
                               Background="Transparent" />

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                                    VerticalAlignment="Center" IsHitTestVisible="False">
                            <controls:EclipseLogoMark Width="24" Height="24" />
                            <TextBlock Text="{x:Static app:App.BrandName}" FontSize="15" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Foreground="White" />
                        </StackPanel>

                        <ItemsControl x:Name="RailItemsControl" Grid.Column="1"
                                      VerticalAlignment="Center" HorizontalAlignment="Left"
                                      Margin="8,0,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:RailNavItem">
                                    <Button Classes="top-nav"
                                            Tag="{Binding Tag}"
                                            ToolTip.Tip="{Binding Title}"
                                            Click="RailItem_Click"
                                            IsVisible="{Binding IsVisible}">
                                        <Border Classes="nav-pill"
                                                Classes.selected="{Binding IsSelected}">
                                            <Panel>
                                                <Border Classes="nav-sheen" IsHitTestVisible="False">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                            <GradientStop Color="#66FFFFFF" Offset="0" />
                                                            <GradientStop Color="#14FFFFFF" Offset="0.28" />
                                                            <GradientStop Color="#00000000" Offset="0.55" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <Border Classes="nav-gloss" Height="14" VerticalAlignment="Top" IsHitTestVisible="False">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                                                            <GradientStop Color="#99FFFFFF" Offset="0" />
                                                            <GradientStop Color="#33FFFFFF" Offset="0.4" />
                                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <StackPanel Orientation="Horizontal" Spacing="6"
                                                            VerticalAlignment="Center">
                                                    <ic:Lucide Icon="{Binding Icon}" Width="14" Height="14"
                                                               VerticalAlignment="Center" StrokeBrush="White" />
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5"
                                                               FontWeight="SemiBold" Foreground="White"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Panel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Grid.Column="2"
                                Width="300" Height="34"
                                VerticalAlignment="Center"
                                CornerRadius="17"
                                ClipToBounds="True"
                                BorderBrush="Transparent" BorderThickness="0"
                                Padding="12,0,12,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                    <GradientStop Color="#DD5C101C" Offset="0" />
                                    <GradientStop Color="#EE1A060A" Offset="0.55" />
                                    <GradientStop Color="#FF0A0406" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <elements:SearchBar DataContext="{Binding SearchBar}"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Ctrl K" FontSize="10"
                                           FontWeight="Medium" Foreground="White"
                                           VerticalAlignment="Center" Opacity="0.7" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="0">
                            <controls:IconButton Classes="TitleBarButton" Icon="Download"
                                                 ToolTip.Tip="Deployment" Click="TopDownload_Click" />
                            <controls:IconButton Classes="TitleBarButton" Icon="Bell"
                                                 ToolTip.Tip="News" Click="TopNews_Click" />
                            <controls:IconButton Name="PART_MinimizeButton" Classes="TitleBarButton" Icon="Minus" />
                            <controls:IconButton Name="PART_MaximizeButton" Classes="TitleBarButton" Icon="Maximize" />
                            <controls:IconButton Name="PART_CloseButton" Classes="TitleBarButton Close" Icon="X" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="24,14,24,0" IsVisible="{Binding ShowPageChrome}">
                        <ItemsControl IsVisible="{Binding HasBreadcrumbs}" ItemsSource="{Binding BreadcrumbItems}" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:BreadcrumbItemModel">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Padding="0" Background="Transparent" BorderThickness="0"
                                                Classes="chrome"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).BreadcrumbItemClickedCommand}"
                                                CommandParameter="{Binding}" Content="{Binding Content}"
                                                FontSize="18" FontWeight="SemiBold" IsVisible="{Binding !IsLast}" />
                                        <TextBlock Text="›" FontSize="18" Opacity="0.5" IsVisible="{Binding !IsLast}" />
                                        <TextBlock Text="{Binding Content}" FontSize="18" FontWeight="SemiBold" IsVisible="{Binding IsLast}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="PageTitleText" FontSize="22" FontWeight="SemiBold"
                                   IsVisible="{Binding ShowPageTitle}" Text="{Binding CurrentPageTitle}" />
                        <controls:MarkdownTextBlock x:Name="PageDescriptionText" Margin="0,4,0,0"
                                                    FontSize="13" Opacity="0.7"
                                                    IsVisible="{Binding CurrentPageDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                    MarkdownText="{Binding CurrentPageDescription}" />
                        <ui:FAInfoBar x:Name="AlertBar" Margin="0,8,0,0" IsVisible="False" Severity="Warning" />
                    </StackPanel>

                    <TransitioningContentControl Grid.Row="1" x:Name="PageContentControl"
                                                 HorizontalAlignment="Stretch"
                                                 VerticalAlignment="Stretch" />
                </Grid>

                <Border Grid.Row="2"
                        IsVisible="{Binding ShowFooter}"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Background="#661A060A"
                        Padding="16,0">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding VersionText}"
                                   FontSize="11"
                                   Foreground="White"
                                   VerticalAlignment="Center" />
                        <controls:IconButton Grid.Column="1" Height="34" Padding="18,0"
                                             Classes="DropDownButton Primary"
                                             Command="{Binding SaveAndLaunchSettingsCommand}"
                                             Content="{Binding LaunchButtonText}">
                            <controls:IconButton.Flyout>
                                <MenuFlyout Placement="TopEdgeAlignedRight">
                                    <MenuItem Header="{Binding PlayerMenuItemText}" Command="{Binding SetLaunchModeCommand}"
                                              CommandParameter="{x:Static enums:LaunchMode.Player}">
                                        <MenuItem.Icon><ic:Lucide Icon="Gamepad2" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{x:Static resources:Strings.Common_Studio}" Command="{Binding SetLaunchModeCommand}"
                                              CommandParameter="{x:Static enums:LaunchMode.Studio}">
                                        <MenuItem.Icon><ic:Lucide Icon="Wrench" /></MenuItem.Icon>
                                    </MenuItem>
                                </MenuFlyout>
                            </controls:IconButton.Flyout>
                        </controls:IconButton>
                        <Button Grid.Column="2" Height="34" Padding="18,0" Classes="accent"
                                Command="{Binding RestartAppCommand}" Content="{x:Static resources:Strings.Menu_Restart}" />
                        <Button Grid.Column="3" Height="34" Padding="18,0" Classes="accent"
                                Command="{Binding SaveSettingsCommand}" Content="{x:Static resources:Strings.Menu_Save}" />
                        <Button Grid.Column="4" Height="34" Padding="18,0" Classes="eclipse-ghost"
                                Command="{Binding CloseWindowCommand}" Content="{x:Static resources:Strings.Common_Close}" />
                    </Grid>
                </Border>
                </Grid>
            </Panel>
        </controls:LiquidGlassPanel>

        <controls:LiquidCursorOverlay x:Name="LiquidCursor"
                                      ZIndex="50"
                                      IsHitTestVisible="False" />

        <Panel Name="NotificationPanel"
               Margin="0,0,0,20" VerticalAlignment="Bottom" ZIndex="1000" />

        <Border x:Name="OffscreenIndexingCanvas"
                Width="905" Height="700"
                IsHitTestVisible="False" IsVisible="False" Opacity="0" ZIndex="-1000" />
    </Panel>
</base:AvaloniaWindow>
