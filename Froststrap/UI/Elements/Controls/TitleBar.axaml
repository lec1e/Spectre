<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Froststrap.UI.Elements.Controls">

    <Style Selector="controls|TitleBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="Auto, *, Auto"
                      Height="{TemplateBinding Height}"
                      Background="{TemplateBinding Background}">

                    <StackPanel Grid.Column="0" Name="PART_LeftPanel" Orientation="Horizontal" IsHitTestVisible="False" VerticalAlignment="Center">
                        <controls:SpectreLogo Width="16" Height="16" Glow="0.35" Margin="12,0,0,0"
                                              IsAnimated="False"
                                              IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        <TextBlock Text="{TemplateBinding Title}"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Margin="8,0"
                                   Foreground="{DynamicResource WbFgMutedBrush}" />
                    </StackPanel>

                    <Panel Grid.Column="1">
                        <Panel Name="PART_DragLayer"
                               WindowDecorationProperties.ElementRole="TitleBar"
                               Background="Transparent"
                               VerticalAlignment="Stretch"
                               HorizontalAlignment="Stretch" />

                        <ContentPresenter Content="{TemplateBinding Content}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center" />
                    </Panel>

                    <StackPanel Grid.Column="2" Name="PART_RightPanel" Orientation="Horizontal" VerticalAlignment="Stretch">
                        <controls:IconButton Name="PART_MinimizeButton"
                                             Classes="TitleBarButton"
                                             Icon="Minus"
                                             IsVisible="{TemplateBinding ShowMinimize}"/>

                        <controls:IconButton Name="PART_MaximizeButton"
                                             Classes="TitleBarButton"
                                             IsVisible="{TemplateBinding ShowMaximize}"
                                             Icon="Maximize"/>

                        <controls:IconButton Name="PART_CloseButton"
                                             Classes="TitleBarButton Close"
                                             Icon="X"
                                             IsVisible="{TemplateBinding ShowClose}"/>
                    </StackPanel>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|IconButton.TitleBarButton">
        <Setter Property="Width" Value="44" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="IconSize" Value="14" />
    </Style>

    <Style Selector="controls|IconButton.TitleBarButton:disabled">
        <Setter Property="Opacity" Value="{DynamicResource ThemeDisabledOpacity}" />
    </Style>
</Styles>
